// Full愈 数据库 Schema
// MySQL + Prisma ORM
// 注意：原 PostgreSQL 数组字段（String[]/Int[]）在 MySQL 下统一改用 Json 存储

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========== 用户系统 ==========

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  nickname  String
  avatar    String?  @db.LongText
  photo     String?  @db.LongText // 个人核验照片（签到用，用户不可自助修改，仅后台/购卡时录入）
  openId    String?  @unique @map("open_id")
  unionId   String?  @map("union_id")
  language  String   @default("zh") // zh | en
  isTrainer Boolean  @default(false) @map("is_trainer")
  /// 社群主理人角色：BASIC=基础（首个社群免费，最多 1 个）；EXTENDED=扩展（平台人工开通，可多个）
  communityHostRole CommunityHostRole? @map("community_host_role")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  memberCards     MemberCard[]
  orders          Order[]
  pointsRecords   PointsRecord[]
  vouchers        Voucher[]
  reviews         Review[]
  checkIns        CheckIn[]
  trainerProfile  TrainerProfile?
  taskClaims      TaskClaim[]
  waitlistEntries WaitlistEntry[]

  @@map("users")
}

model TrainerProfile {
  id           String        @id @default(cuid())
  userId       String        @unique @map("user_id")
  displayName  String        @unique @map("display_name") // 全局唯一
  avatar       String?       @db.LongText
  level        Int           @default(1) // LV1 - LV5
  status       TrainerStatus @default(ACTIVE) // 在职状态
  seedifyCert  Boolean       @default(false) @map("seedify_cert") // Seedify认证
  certBadge    String?       @map("cert_badge") // 认证等级徽章
  specialties  Json // 擅长课程标签（string[]），支持模糊搜索
  bio          String?       @db.Text // 个人简介
  hourlyRate   Decimal       @default(0) @map("hourly_rate") // 小时单价（只读，由等级配置决定）
  seedsBalance Int           @default(0) @map("seeds_balance")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  courses      Course[]
  seedsRecords SeedsRecord[]

  @@map("trainer_profiles")
}

enum TrainerStatus {
  ACTIVE // 在职
  RESIGNED // 离职
}

// ========== 会员卡 ==========

model MemberCard {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      MemberCardType
  status    MemberCardStatus @default(ACTIVE)
  startDate DateTime         @map("start_date")
  endDate   DateTime         @map("end_date")
  absences  Int              @default(0) // 当月未出席次数
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("member_cards")
}

enum MemberCardType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MemberCardStatus {
  ACTIVE
  FROZEN
  EXPIRED
}

// 会员卡商品（后台可发布/配置价格）
model MemberCardProduct {
  id           String                  @id @default(cuid())
  type         MemberCardType
  name         String
  price        Decimal
  durationDays Int                     @map("duration_days")
  description  String?
  benefits     Json // string[]
  status       MemberCardProductStatus @default(ON_SHELF)
  sort         Int                     @default(0)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  orders Order[]

  @@map("member_card_products")
}

enum MemberCardProductStatus {
  ON_SHELF
  OFF_SHELF
}

// ========== 积分系统 ==========

model PointsRecord {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  amount    Int // 正数=增加，负数=减少
  balance   Int // 变动后余额
  type      PointsChangeType
  reason    String // 变动原因描述
  relatedId String?          @map("related_id") // 关联的订单/课程ID
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("points_records")
}

enum PointsChangeType {
  COURSE_REWARD
  REVIEW_REWARD
  CONSUMPTION
  EXCHANGE
  ADMIN_ADJUST
  OTHER
}

// ========== Seeds系统（培训师积分） ==========

model SeedsRecord {
  id        String   @id @default(cuid())
  trainerId String   @map("trainer_id")
  amount    Int // 正数=增加，负数=减少
  balance   Int // 变动后余额
  type      String // COURSE_SETTLEMENT | TASK_REWARD | ADMIN_ADJUST
  reason    String
  relatedId String?  @map("related_id")
  createdAt DateTime @default(now()) @map("created_at")

  trainer TrainerProfile @relation(fields: [trainerId], references: [id])

  @@map("seeds_records")
}

// ========== 课程系统 ==========

model Course {
  id                    String       @id @default(cuid())
  title                 String
  coverImage            String       @map("cover_image") @db.LongText
  type                  CourseType
  categories            Json // 课程分类标签（string[]）
  description           String       @db.Text // 富文本
  targetAudience        Json         @map("target_audience") // string[]
  learningGoals         String?      @map("learning_goals") @db.Text
  startDate             DateTime     @map("start_date")
  endDate               DateTime     @map("end_date")
  startTime             String       @map("start_time") // HH:mm
  endTime               String       @map("end_time") // HH:mm
  trainerId             String       @map("trainer_id")
  minCapacity           Int          @map("min_capacity")
  maxCapacity           Int          @map("max_capacity")
  currentEnrolled       Int          @default(0) @map("current_enrolled")
  originalPrice         Decimal      @map("original_price")
  venueId               String       @map("venue_id")
  status                CourseStatus @default(DRAFT)
  trainerSeeds          Int          @default(0) @map("trainer_seeds") // 导师可获积分
  allowDeduction        Boolean      @default(true) @map("allow_deduction") // 是否支持积分抵扣
  internalNote          String?      @map("internal_note") @db.Text // 内部备注
  enrollStartAt         DateTime?    @map("enroll_start_at")
  enrollEndAt           DateTime?    @map("enroll_end_at")
  memberEnrollStartAt   DateTime?    @map("member_enroll_start_at") // 会员提前报名时间
  refundRules           Json?        @map("refund_rules") // 退款规则 [{hoursFrom,hoursTo,refundPercent}]
  gallery               Json // 课程详情图集（string[]）
  scheduleType          ScheduleType @default(ONE_TIME) @map("schedule_type")
  weekdays              Json // 周期性排课的星期 [1-7]（number[]）
  waitlistEnabled       Boolean      @default(true) @map("waitlist_enabled")
  waitlistDeadlineHours Decimal?     @map("waitlist_deadline_hours") // 候补截止（开课前小时数）
  memberWaitlistSeats   Int          @default(3) @map("member_waitlist_seats") // 会员候补席位数
  // 后台表单补充字段（草稿/发布均可持久化，多为可空）
  detailDesc            String?      @map("detail_desc") @db.Text // 课程详细介绍
  difficulty            String? // 难度：BEGINNER/INTERMEDIATE/ADVANCED
  assistantId           String?      @map("assistant_id") // 助教
  coverType             String?      @map("cover_type") // upload/gradient
  coverColor            String?      @map("cover_color") // 渐变封面色值
  duration              Int? // 单节时长（分钟）
  totalSessions         Int?         @map("total_sessions") // 总节数
  materials             Json? // 所需物料（string[]）
  groupDeadline         DateTime?    @map("group_deadline") // 最晚成团时间
  voucherPolicy         String?      @map("voucher_policy") // ALL/SOME/NONE
  seedsReward           Int?         @map("seeds_reward") // 每节完课奖励
  reviewSeeds           Int?         @map("review_seeds") // 提交评价奖励
  syllabus              Json? // 课程大纲 [{title,content}]
  notice                String?      @db.Text // 学员须知
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  // Relations
  trainer         TrainerProfile         @relation(fields: [trainerId], references: [id])
  venue           Venue                  @relation(fields: [venueId], references: [id])
  orders          Order[]
  checkIns        CheckIn[]
  reviews         Review[]
  priceTiers      CoursePriceTier[]
  waitlistEntries WaitlistEntry[]
  memberDiscounts CourseMemberDiscount[]
  reservation     VenueReservation?

  @@map("courses")
}

enum CourseType {
  SINGLE
  SERIES
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum ScheduleType {
  ONE_TIME
  WEEKLY
  APPOINTMENT
}

// 课程阶梯价格（按报名顺序区间锁价）
model CoursePriceTier {
  id       String  @id @default(cuid())
  courseId String  @map("course_id")
  seatFrom Int     @map("seat_from") // 报名顺序区间起（含）
  seatTo   Int     @map("seat_to") // 报名顺序区间止（含）
  price    Decimal // 该区间价格

  course Course @relation(fields: [courseId], references: [id])

  @@unique([courseId, seatFrom])
  @@map("course_price_tiers")
}

// 课程会员折扣（按卡类型配置折扣百分比）
model CourseMemberDiscount {
  id              String         @id @default(cuid())
  courseId        String         @map("course_id")
  cardType        MemberCardType @map("card_type")
  discountPercent Int            @map("discount_percent") // 折扣百分比，如 70 表示 7 折

  course Course @relation(fields: [courseId], references: [id])

  @@unique([courseId, cardType])
  @@map("course_member_discounts")
}

// ========== 会员卡分时段折扣 ==========

enum TimeDiscountActionType {
  PERCENT // 百分比折扣率
  FIXED_BY_DURATION // 按服务时长取固定价
}

enum TimeDiscountRuleStatus {
  ENABLED
  DISABLED
}

// 会员卡时段折扣规则（门店/卡类型多选，空=全部；手动优先级 + 门店特异性匹配）
model MemberTimeDiscountRule {
  id              String                 @id @default(cuid())
  name            String // 规则名（后台识别用，如"周末峰值"）
  orgIds          Json                   @default("[]") @map("org_ids") // string[]；空=全部门店（兜底）
  cardTypes       Json                   @default("[]") @map("card_types") // MemberCardType[]；空=全部卡类型
  priority        Int                    @default(0) // 越小越优先（同特异性分组内），后台调序
  weekdays        Json                   @default("[]") // number[] [1-7]（1=周一…7=周日）；空=不限
  timeRanges      Json                   @default("[]") @map("time_ranges") // [{start:"HH:mm",end:"HH:mm"}] 含头不含尾；空=全天
  validFrom       DateTime?              @map("valid_from") // 生效起始日（含）；空=不限
  validTo         DateTime?              @map("valid_to") // 生效截止日（含）；空=长期
  actionType      TimeDiscountActionType @map("action_type")
  discountPercent Int?                   @map("discount_percent") // PERCENT 必填：50–200（100=原价，>100 加价）
  fixedPrices     Json?                  @map("fixed_prices") // FIXED_BY_DURATION 必填：[{minutes:Int, price:Number(元)}]
  status          TimeDiscountRuleStatus @default(ENABLED)
  remark          String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@index([status, priority])
  @@map("member_time_discount_rules")
}

// 候补队列（预付模式 + 双队列：会员席位 + 普通席位）
model WaitlistEntry {
  id          String           @id @default(cuid())
  courseId    String           @map("course_id")
  userId      String           @map("user_id")
  seatType    WaitlistSeatType @map("seat_type")
  position    Int
  orderId     String?          @unique @map("order_id")
  lockedPrice Decimal          @map("locked_price")
  status      WaitlistStatus   @default(PENDING_PAYMENT)
  paidAt      DateTime?        @map("paid_at")
  convertedAt DateTime?        @map("converted_at")
  refundedAt  DateTime?        @map("refunded_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@map("waitlist_entries")
}

enum WaitlistSeatType {
  MEMBER
  NORMAL
}

enum WaitlistStatus {
  PENDING_PAYMENT
  WAITING
  CONVERTED
  CANCELLED
  REFUNDED
}

enum OrderType {
  COURSE
  WAITLIST
  MEMBER_CARD
  COMMUNITY
}

// ========== 场地 ==========

model Venue {
  id      String  @id @default(cuid())
  name    String
  /// city：小程序首页按城市筛选场地
  city    String  @default("上海")
  address String
  /// 归属门店/组织：本系统（小程序）订单的收入按 订单→课程→场馆→组织 归集到门店
  orgId   String? @map("org_id")

  capacity      Int      @default(0) // 场地容量（人）
  description   String?  @db.Text // 场地描述/设备特点
  images        Json // string[]
  businessHours String   @map("business_hours") @db.Text // JSON
  isAvailable   Boolean  @default(true) @map("is_available")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  courses      Course[]
  reservations VenueReservation[]
  org          Organization?      @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("venues")
}

model VenueReservation {
  id              String   @id @default(cuid())
  venueId         String   @map("venue_id")
  courseId        String?  @unique @map("course_id") // 非空表示由课程发布自动登记的占用
  date            DateTime
  startTime       String   @map("start_time")
  endTime         String   @map("end_time")
  eventName       String   @map("event_name")
  contactName     String   @map("contact_name")
  contactPhone    String   @map("contact_phone")
  internalContact String?  @map("internal_contact")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  // 使用类型与合同字段（INTERNAL / RENTAL；课程占用不填写 useType，默认 RENTAL 也不影响课程旧数据）
  useType        String    @default("RENTAL") @map("use_type") // INTERNAL / RENTAL
  contractStatus String?   @map("contract_status") // INTENT / SIGNED；内部使用为 null
  salesId        String?   @map("sales_id") // 我方销售 admin id
  salesName      String?   @map("sales_name") // 我方销售名（冗余展示）
  contractUrl    String?   @map("contract_url") @db.Text // 合同文件 URL（OSS）
  contractName   String?   @map("contract_name") // 合同文件名
  signedAt       DateTime? @map("signed_at") // 签约时间
  totalAmount    Int?      @map("total_amount") // 应收总额（分）
  paidAmount     Int       @default(0) @map("paid_amount") // 已收金额（分）

  venue    Venue          @relation(fields: [venueId], references: [id])
  course   Course?        @relation(fields: [courseId], references: [id])
  payments VenuePayment[]

  @@index([contractStatus])
  @@index([useType])
  @@map("venue_reservations")
}

// 场地预约收款流水（仅针对 useType=RENTAL；一个预约可多次收款）
model VenuePayment {
  id            String @id @default(cuid())
  reservationId String @map("reservation_id")
  amount        Int // 金额（分）
  method        String // OFFLINE_TRANSFER / QR_CODE

  // 线下转账专属
  transferAt   DateTime? @map("transfer_at")
  counterparty String?

  // 二维码收款专属
  qrChannel String?   @map("qr_channel") // ALIPAY / WECHAT
  paidAt    DateTime? @map("paid_at")

  status       String   @default("PENDING") // PENDING / CONFIRMED / CANCELLED
  operatorId   String?  @map("operator_id")
  operatorName String?  @map("operator_name")
  remark       String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  reservation VenueReservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([status])
  @@map("venue_payments")
}

// 场地预约操作日志（占用/取消变动记录，便于争议追溯）
model VenueReservationLog {
  id            String    @id @default(cuid())
  reservationId String?   @map("reservation_id") // 预约被删除后仍保留
  venueId       String    @map("venue_id")
  venueName     String?   @map("venue_name")
  courseId      String?   @map("course_id") // 非空 = 课程联动
  courseTitle   String?   @map("course_title")
  action        String // CREATE / CANCEL_RENTAL / COURSE_RESERVE / COURSE_RELEASE / COURSE_EXPIRE_RELEASE
  source        String    @default("ADMIN") // ADMIN / SYSTEM / COURSE_STATUS
  operatorId    String?   @map("operator_id")
  operatorName  String?   @map("operator_name")
  eventName     String?   @map("event_name")
  date          DateTime?
  startTime     String?   @map("start_time")
  endTime       String?   @map("end_time")
  reason        String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([venueId, createdAt])
  @@index([courseId])
  @@map("venue_reservation_logs")
}

// ========== 订单与支付 ==========

model Order {
  id                  String          @id @default(cuid())
  orderNo             String          @unique @default(cuid()) @map("order_no") // 自定义订单号 C/M/W+YYMMDD+5位流水（默认 cuid 兼容旧逻辑）
  userId              String          @map("user_id")
  courseId            String?         @map("course_id")
  communityId         String?         @map("community_id")
  orderType           OrderType       @default(COURSE) @map("order_type")
  memberCardProductId String?         @map("member_card_product_id")
  memberCardId        String?         @map("member_card_id") // 支付成功后生成的会员卡ID
  cardType            MemberCardType? @map("card_type")
  originalPrice       Decimal         @map("original_price")
  discountAmount      Decimal         @default(0) @map("discount_amount")
  pointsDeduction     Decimal         @default(0) @map("points_deduction")
  voucherDeduction    Decimal         @default(0) @map("voucher_deduction")
  actualPaid          Decimal         @map("actual_paid")
  status              OrderStatus     @default(PENDING_PAYMENT)
  paymentId           String?         @map("payment_id") // 微信支付单号
  paymentTime         DateTime?       @map("payment_time")
  cancelTime          DateTime?       @map("cancel_time")
  cancelReason        String?         @map("cancel_reason") @db.Text
  refundAmount        Decimal?        @map("refund_amount")
  refundTime          DateTime?       @map("refund_time")
  voucherId           String?         @map("voucher_id")
  /// 社群年费订单使用的邀请/礼遇（对账用）
  communityInviteId      String?      @map("community_invite_id")
  communityInviteClaimId String?      @map("community_invite_claim_id")
  /// 平台服务费（分）：按实付金额 10% 计提，免年费为 0
  platformFee         Decimal         @default(0) @map("platform_fee")
  hitTimeRuleId       String?         @map("hit_time_rule_id") // 命中的时段折扣规则（对账/排查用）
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id])
  course            Course?            @relation(fields: [courseId], references: [id])
  community         Community?         @relation(fields: [communityId], references: [id])
  voucher           Voucher?           @relation(fields: [voucherId], references: [id])
  memberCardProduct MemberCardProduct? @relation(fields: [memberCardProductId], references: [id])
  refunds          OrderRefund[]
  waitlistEntry     WaitlistEntry?

  @@map("orders")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

/// 订单退款流水（强制退款按次留痕）。
/// status: PROCESSING 受理中 / SUCCESS 已到账 / FAILED 网关明确拒绝（可重发）
///        / UNKNOWN 结果待确认（人工核对后可重试或确认失败）/ CANCELLED 人工确认未发生退款后作废
/// source: ADMIN_FORCE 后台强制退款 / SELF_SERVICE 用户自助退款 / SYSTEM 系统自动退款
/// amountFen 统一以「分」存储（会员卡订单按分换算），与 Order 金额列口径解耦。
model OrderRefund {
  id              String    @id @default(cuid())
  orderId         String    @map("order_id")
  outRefundNo     String    @unique @map("out_refund_no") // RF+订单id，同一次退款重试保持不变，网关幂等
  amountFen       Int       @map("amount_fen")
  status          String    @default("PROCESSING")
  source          String    @default("ADMIN_FORCE")
  prevOrderStatus String?   @map("prev_order_status") // 本次退款前订单状态，部分退款到账后回退
  reason          String?   @db.Text
  operatorId      String?   @map("operator_id")
  operatorName    String?   @map("operator_name")
  approvalId      String?   @map("approval_id")
  gatewayRef      String?   @map("gateway_ref") // 网关退款流水号
  failCode        String?   @map("fail_code")
  failMessage     String?   @map("fail_message") @db.Text
  attempts        Int       @default(1) // 同一流水号向网关发起的次数
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  settledAt       DateTime? @map("settled_at") // SUCCESS/FAILED 终态时间
  order           Order     @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
  @@index([status])
  @@map("order_refunds")
}

// ========== 签到 ==========

model CheckIn {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  courseId  String        @map("course_id")
  method    CheckInMethod
  checkedAt DateTime      @default(now()) @map("checked_at")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("check_ins")
}

enum CheckInMethod {
  MANUAL
}

// ========== 课程评价 ==========

model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  rating    Int // 1-5
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("reviews")
}

// ========== 代金券 ==========

model Voucher {
  id                  String        @id @default(cuid())
  /// 兑换码批次券在被领取前为空
  userId              String?       @map("user_id")
  mode                VoucherMode   @default(REDUCE_BY) // REDUCE_BY 减额 / REDUCE_TO 减至
  amount              Decimal // 减额模式：抵扣面额；减至模式：忽略
  targetPrice         Decimal?      @map("target_price") // 减至模式：将实付减至该价格
  applicableCourseIds Json          @map("applicable_course_ids") // string[]
  applicableAll       Boolean       @default(false) @map("applicable_all")
  expiresAt           DateTime      @map("expires_at")
  status              VoucherStatus @default(UNUSED)
  source              String // 来源描述
  usedAt              DateTime?     @map("used_at")
  /// 兑换码（批量发券，每张唯一；用户输入后归属该用户）
  redeemCode          String?       @unique @map("redeem_code") @db.VarChar(16)
  /// 发券批次号（同一次批量发放共享）
  batchNo             String?       @map("batch_no") @db.VarChar(32)
  /// 兑换时间
  redeemedAt          DateTime?     @map("redeemed_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([batchNo])
  @@map("vouchers")
}

enum VoucherStatus {
  UNUSED
  USED
  EXPIRED
  REVOKED
}

enum VoucherMode {
  REDUCE_BY
  REDUCE_TO
}

// ========== 任务系统 ==========

model Task {
  id                 String     @id @default(cuid())
  title              String
  description        String     @db.Text
  seedsReward        Int        @map("seeds_reward") // 每人可获得 seeds
  publisherCost      Int        @default(0) @map("publisher_cost") // 发布方消耗
  maxParticipants    Int        @map("max_participants")
  scope              TaskScope  @default(ALL)
  specificTrainerIds Json       @map("specific_trainer_ids") // string[]
  status             TaskStatus @default(PUBLISHED)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  claims TaskClaim[]

  @@map("tasks")
}

enum TaskScope {
  ALL
  SPECIFIC
}

enum TaskStatus {
  PUBLISHED
  COMPLETED
  CANCELLED
}

model TaskClaim {
  id          String          @id @default(cuid())
  taskId      String          @map("task_id")
  userId      String          @map("user_id")
  status      TaskClaimStatus @default(CLAIMED)
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@map("task_claims")
}

enum TaskClaimStatus {
  CLAIMED
  COMPLETED
  CANCELLED
}

// ========== 物料管理 ==========

model Material {
  id        String   @id @default(cuid())
  name      String
  image     String?  @db.LongText // 物料图片
  quantity  Int
  usageType String   @default("CONSUMABLE") @map("usage_type") // CONSUMABLE=一次性消耗 | REUSABLE=循环使用
  unitPrice Decimal  @map("unit_price")
  seedsCost Int      @map("seeds_cost") // 使用所需积分
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("materials")
}

// ========== 课程标签 ==========

model CourseTag {
  id     String @id @default(cuid())
  nameZh String @map("name_zh")
  nameEn String @map("name_en")
  sort   Int    @default(0)

  @@map("course_tags")
}

// ========== 值集字典（后台可维护） ==========

// 导师等级配置（等级 -> 名称 -> 默认时薪）
model TrainerLevel {
  id         String   @id @default(cuid())
  level      Int      @unique // 1-5
  name       String // 等级名称，如 LV1 初级导师
  hourlyRate Decimal  @default(0) @map("hourly_rate") // 该等级默认时薪
  sort       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("trainer_levels")
}

model DictSet {
  id        String   @id @default(cuid())
  code      String   @unique // 值集编码，如 trainer_tag
  name      String
  desc      String?
  system    Boolean  @default(false) // 系统内置不可删除
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items DictItem[]

  @@map("dict_sets")
}

model DictItem {
  id      String  @id @default(cuid())
  setId   String  @map("set_id")
  value   String
  label   String
  color   String?
  enabled Boolean @default(true)
  sort    Int     @default(0)

  set DictSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, value])
  @@map("dict_items")
}

// ========== 组织架构（全系统主数据） ==========

/// 组织节点：集团 / 总部部门 / 子公司 / 门店。
/// 进销存的仓库主体、财务核算主体、审批人范围、后台数据行级权限均以此为唯一来源。
model Organization {
  id        String  @id // 可读主键，如 HQ / D-PUR / C001 / S001
  name      String
  shortName String  @map("short_name")
  code      String  @unique
  type      OrgType
  parentId  String? @map("parent_id")
  leader    String  @default("")
  phone     String  @default("")

  /// 独立财务核算主体：财务看板按此维度出利润
  accounting   Boolean @default(false)
  /// 有独立仓库：可作为进销存收货/库存主体
  hasWarehouse Boolean @default(false) @map("has_warehouse")
  /// 可作为采购方向上级或外部供应商下单
  canPurchase  Boolean @default(false) @map("can_purchase")

  /// 总部抽取的管理费比例（如 0.15），仅门店有意义
  mgmtFeeRate  Decimal @default(0) @map("mgmt_fee_rate") @db.Decimal(6, 4)
  /// 总部抽取的培训费比例（如 0.02）
  trainFeeRate Decimal @default(0) @map("train_fee_rate") @db.Decimal(6, 4)

  /// 月保底租金（元）：与提成租金取高后计入看板房租
  baseRent    Decimal @default(0) @map("base_rent") @db.Decimal(12, 2)
  /// 提成租金比例（如 0.06）：按当月收入流水总额计提
  rentRate    Decimal @default(0) @map("rent_rate") @db.Decimal(6, 4)
  /// 月物业费（元）：固定额，不随营收浮动
  propertyFee Decimal @default(0) @map("property_fee") @db.Decimal(12, 2)

  status    OrgStatus @default(ACTIVE)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  parent   Organization?  @relation("OrgTree", fields: [parentId], references: [id])
  children Organization[] @relation("OrgTree")
  admins   AdminUser[]
  venues   Venue[]

  @@index([parentId])
  @@index([type, status])
  @@map("organizations")
}

enum OrgType {
  GROUP // 集团总部
  DEPT // 总部部门
  SUBSIDIARY // 子公司
  STORE // 门店
}

enum OrgStatus {
  ACTIVE
  DISABLED
}

// ========== 后台管理系统 ==========

model AdminUser {
  id                 String   @id @default(cuid())
  username           String   @unique
  password           String
  name               String
  phone              String?
  /// 归属组织：数据行级权限的判定基准（超管可为空表示不受限）
  orgId              String?  @map("org_id")
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(true) @map("must_change_password") // 首次登录强制改密
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  roles AdminUserRole[]
  org   Organization?   @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("admin_users")
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  /// 数据行级范围：多角色取最宽松者。仅作用于按组织核算的模块（进销存/财务）
  dataScope   DataScope @default(OWN) @map("data_scope")
  /// 内置角色不允许删除
  isBuiltin   Boolean   @default(false) @map("is_builtin")
  createdAt   DateTime  @default(now()) @map("created_at")

  users       AdminUserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// 数据行级可见范围，由宽到严
enum DataScope {
  ALL // 全部组织
  OWN_AND_SUB // 本组织及其下级
  OWN // 仅本组织
  SELF // 仅本人创建的单据
}

model Permission {
  id        String    @id @default(cuid())
  code      String    @unique // e.g. "course:create", "finance:dashboard:profit"
  name      String
  module    String // 所属模块：education, sales, system, org, scm, finance, flow
  /// 粒度：MENU 菜单/页面、TAB 页面内标签页、ACTION 按钮动作、FIELD 敏感数据块
  level     PermLevel @default(ACTION)
  /// 同模块内的展示分组名，用于权限树折叠，如「采购订单」
  groupName String    @default("") @map("group_name")
  sortOrder Int       @default(0) @map("sort_order")

  roles RolePermission[]

  @@index([module, sortOrder])
  @@map("permissions")
}

enum PermLevel {
  MENU
  TAB
  ACTION
  FIELD
}

model AdminUserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user AdminUser @relation(fields: [userId], references: [id])
  role Role      @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ========== 系统配置 ==========

/// 通用系统配置 KV
model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

// ========== 结算 ==========

model Settlement {
  id             String           @id @default(cuid())
  trainerId      String           @map("trainer_id")
  trainerName    String           @map("trainer_name") // 冗余导师名
  courseId       String           @map("course_id")
  courseName     String           @map("course_name") // 冗余课程名
  hours          Decimal // 课程时长
  rate           Decimal // 小时单价
  amount         Decimal // 结算金额
  adjustedAmount Decimal?         @map("adjusted_amount") // 人工调整后金额
  adjustNote     String?          @map("adjust_note") @db.Text // 调整说明
  status         SettlementStatus @default(NORMAL)
  settledAt      DateTime         @default(now()) @map("settled_at")

  @@map("settlements")
}

enum SettlementStatus {
  NORMAL // 正常
  ADJUSTED // 已调整
}

// ========== 运营位 ==========

/// 首页运营 Banner（后台可配置轮播位）
model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?  @db.Text // 副标题/描述
  bg        String? // 背景渐变色，如 linear-gradient(135deg, #6B463C, #A07060)
  imageUrl  String?  @map("image_url") @db.LongText // 背景图（存在时优先于渐变色）
  linkType  String   @default("none") @map("link_type") // none | course
  linkValue String?  @map("link_value") // 关联课程 id 等
  sortOrder Int      @default(0) @map("sort_order") // 越小越靠前
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

// ========== 审批流引擎 ==========

/// 可走审批的单据类型（全系统共用一套引擎）
enum ApprovalBizType {
  PURCHASE_ORDER // 采购订单
  EXPENSE_ENTRY // 费用录入
  STOCK_ADJUST // 库存调整
  VOUCHER_GRANT // 代金券发放
  ORDER_FORCE_REFUND // 订单强制退款
}

/// 流程适用的组织范围：同一单据类型下总部与门店可走不同节点
enum ApprovalFlowScope {
  ALL // 全部组织
  HQ // 仅总部/部门
  STORE // 仅子公司/门店
}

/// 节点内多审批人时的通过规则
enum ApprovalNodeMode {
  ALL // 会签：全部同意
  ANY // 或签：一人同意即可
}

enum ApprovalInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalNodeStatus {
  WAITING // 未到达
  PROCESSING // 审批中
  APPROVED
  REJECTED
}

enum ApprovalDecisionAction {
  APPROVE
  REJECT
}

/// 审批流规则：按单据类型 + 组织范围 + 金额区间 命中
model ApprovalFlowRule {
  id        String            @id @default(cuid())
  bizType   ApprovalBizType   @map("biz_type")
  name      String
  scope     ApprovalFlowScope @default(ALL)
  /// 金额下限（含），null 为不限
  minAmount Decimal?          @map("min_amount") @db.Decimal(12, 2)
  /// 金额上限（不含），null 为不限
  maxAmount Decimal?          @map("max_amount") @db.Decimal(12, 2)
  enabled   Boolean           @default(true)
  remark    String            @default("") @db.VarChar(500)
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  nodes ApprovalFlowNode[]

  @@index([bizType, enabled])
  @@map("approval_flow_rules")
}

/// 流程节点模板
model ApprovalFlowNode {
  id        String           @id @default(cuid())
  ruleId    String           @map("rule_id")
  name      String
  mode      ApprovalNodeMode @default(ANY)
  /// 审批人登录名（手机号）数组：比 cuid 稳定，重新 seed 也不会把节点打成空
  approvers Json
  sortOrder Int              @default(0) @map("sort_order")

  rule ApprovalFlowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("approval_flow_nodes")
}

/// 审批实例：单据提交时根据命中的规则快照生成
model ApprovalInstance {
  id      String          @id // 可读单号 AP+日期+序号
  bizType ApprovalBizType @map("biz_type")
  /// 关联业务单据 id；代金券/退款类无实体单据时为空字符串
  bizId   String          @default("") @map("biz_id")
  summary String          @db.Text
  amount  Decimal         @default(0) @db.Decimal(12, 2)
  /// 发起方组织，用于命中流程的组织范围与数据权限过滤
  orgId   String?         @map("org_id")

  requester     String @default("") // 发起人登录名
  requesterName String @default("") @map("requester_name")

  flowId   String? @map("flow_id")
  flowName String  @default("") @map("flow_name")

  currentIndex Int                    @default(0) @map("current_index")
  status       ApprovalInstanceStatus @default(PENDING)

  /// 通过后执行副作用所需的参数快照（如发券行、退款金额）
  payload    Json?
  /// 执行结果或失败原因
  resultNote String?   @map("result_note") @db.Text
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  nodes ApprovalInstanceNode[]

  @@index([status, bizType])
  @@index([bizType, bizId])
  @@index([orgId])
  @@map("approval_instances")
}

/// 实例节点：从模板拷贝，之后模板改动不影响已在跑的单
model ApprovalInstanceNode {
  id         String             @id @default(cuid())
  instanceId String             @map("instance_id")
  name       String
  mode       ApprovalNodeMode
  approvers  Json
  status     ApprovalNodeStatus @default(WAITING)
  sortOrder  Int                @default(0) @map("sort_order")

  instance  ApprovalInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  decisions ApprovalDecision[]

  @@index([instanceId])
  @@map("approval_instance_nodes")
}

/// 单次审批意见
model ApprovalDecision {
  id           String                 @id @default(cuid())
  nodeId       String                 @map("node_id")
  approver     String // 审批人登录名
  approverName String                 @default("") @map("approver_name")
  action       ApprovalDecisionAction
  comment      String                 @default("") @db.VarChar(500)
  createdAt    DateTime               @default(now()) @map("created_at")

  node ApprovalInstanceNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("approval_decisions")
}

// ========== 进销存 ==========

/// 合作方：物料/包材供应商，或承接组装加工的代工厂
model ScmSupplier {
  id        String   @id @default(cuid())
  name      String
  contact   String   @default("")
  phone     String   @default("")
  /// 代工厂：承接委外组装，不供料，按工单收加工费
  isProcessor Boolean @default(false) @map("is_processor")
  enabled   Boolean  @default(true)
  remark    String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders    PurchaseOrder[]
  locations ScmLocation[]
  prices    ScmPurchasePrice[]

  @@map("scm_suppliers")
}

/// 物料分层：原料/包材进入 BOM，成品由生产或采购产生，耗材只自用不进配方
enum ScmProductType {
  RAW // 原料（料体、精油）
  PACK // 包材（瓶、泵头、包装盒）
  SEMI // 半成品
  FINISHED // 成品（含第三方采购的可供货商品）
  CONSUMABLE // 自用耗材
}

/// 进销存商品/耗材主数据（与小程序侧 Material 无关：后者是课程用料，带积分消耗）
model ScmProduct {
  id            String         @id @default(cuid())
  /// 可读编码，如 P001
  code          String         @unique
  name          String
  spec          String         @default("")
  unit          String         @default("")
  /// 物料分层；历史数据默认按成品处理，可在档案里改
  type          ScmProductType @default(FINISHED)
  /// 总部向供应商的采购参考价
  purchasePrice Decimal @default(0) @map("purchase_price") @db.Decimal(10, 2)
  /// 总部供给门店的供货价
  supplyPrice   Decimal @default(0) @map("supply_price") @db.Decimal(10, 2)
  /// 低于此数在库存页告警
  safetyStock   Int     @default(0) @map("safety_stock")
  /// 保质期天数；0 表示不管理效期
  shelfLifeDays Int     @default(0) @map("shelf_life_days")
  enabled       Boolean @default(true)
  remark        String  @default("") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  balances      StockBalance[]
  boms          ScmBom[]             @relation("BomProduct")
  bomComponents ScmBomItem[]         @relation("BomComponent")
  transfers     ScmTransferItem[]
  productions   ScmProductionOrder[]
  productionComponents ScmProductionItem[]
  prices        ScmPurchasePrice[]
  batches       ScmStockBatch[]

  @@index([type, enabled])
  @@map("scm_products")
}

/// 库存地点：自有仓直接复用组织 id，供应商/代工厂/在途是独立地点
enum ScmLocationType {
  OWN // 自有仓
  SUPPLIER // 供应商处（货权可能仍属我们）
  FACTORY // 代工厂处（已发料待加工）
  TRANSIT // 在途
}

model ScmLocation {
  id         String          @id
  name       String
  type       ScmLocationType @default(OWN)
  /// 物权归属组织：自有仓即仓库组织；供应商/代工厂地点挂在总部名下
  orgId      String?         @map("org_id")
  supplierId String?         @map("supplier_id")
  enabled    Boolean         @default(true)
  remark     String          @default("") @db.VarChar(500)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  supplier ScmSupplier? @relation(fields: [supplierId], references: [id])

  @@index([type, enabled])
  @@index([orgId])
  @@map("scm_locations")
}

/// 单层 BOM：成品 ← 原料/包材，按版本管理，工单下单时快照
enum ScmBomStatus {
  ACTIVE
  ARCHIVED
}

model ScmBom {
  id        String       @id @default(cuid())
  productId String       @map("product_id")
  version   Int          @default(1)
  status    ScmBomStatus @default(ACTIVE)
  remark    String       @default("") @db.VarChar(500)
  createdBy String       @default("") @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  product ScmProduct   @relation("BomProduct", fields: [productId], references: [id], onDelete: Cascade)
  items   ScmBomItem[]

  @@unique([productId, version])
  @@index([productId, status])
  @@map("scm_boms")
}

model ScmBomItem {
  id          String   @id @default(cuid())
  bomId       String   @map("bom_id")
  componentId String   @map("component_id")
  /// 下单时快照，主数据改名不影响历史工单
  name        String
  spec        String   @default("")
  unit        String   @default("")
  /// 每 1 个成品的耗用量，支持小数（如 0.12 kg）
  qtyPerUnit  Decimal  @default(0) @map("qty_per_unit") @db.Decimal(14, 6)
  /// 损耗率，0.02 表示 2%
  lossRate    Decimal  @default(0) @map("loss_rate") @db.Decimal(6, 4)
  remark      String   @default("") @db.VarChar(500)

  bom       ScmBom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component ScmProduct  @relation("BomComponent", fields: [componentId], references: [id])

  @@index([bomId])
  @@index([componentId])
  @@map("scm_bom_items")
}

enum ScmTransferStatus {
  COMPLETED
  CANCELLED
}

/// 库存调拨：同事务内源地点出库、目标地点入库。总部供货门店也走这里
model ScmTransfer {
  id             String            @id
  fromLocationId String            @map("from_location_id")
  toLocationId   String            @map("to_location_id")
  fromOwnerOrgId String            @map("from_owner_org_id")
  toOwnerOrgId   String            @map("to_owner_org_id")
  status         ScmTransferStatus @default(COMPLETED)
  remark         String            @default("") @db.VarChar(500)
  createdBy      String            @default("") @map("created_by")
  createdByName  String            @default("") @map("created_by_name")
  createdAt      DateTime          @default(now()) @map("created_at")

  items ScmTransferItem[]

  @@index([fromLocationId, createdAt])
  @@index([toLocationId, createdAt])
  @@index([createdAt])
  @@map("scm_transfers")
}

model ScmTransferItem {
  id         String  @id @default(cuid())
  transferId String  @map("transfer_id")
  productId  String  @map("product_id")
  name       String
  spec       String  @default("")
  unit       String  @default("")
  qty        Decimal @default(0) @db.Decimal(14, 3)

  transfer ScmTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  ScmProduct  @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("scm_transfer_items")
}

enum ScmProductionStatus {
  APPROVED // 待领料
  ISSUED // 已发料/加工中
  COMPLETED // 已完工入库
  CANCELLED
}

/// 生产/委外工单：成品 × 计划量，按 BOM 领料，完工后成品入库
model ScmProductionOrder {
  id          String              @id
  /// 物权组织（生产方）
  orgId       String              @map("org_id")
  productId   String              @map("product_id")
  productName String              @default("") @map("product_name")
  productSpec String              @default("") @map("product_spec")
  productUnit String              @default("") @map("product_unit")
  /// BOM 版本快照
  bomVersion  Int                 @default(1) @map("bom_version")
  plannedQty  Decimal             @default(0) @map("planned_qty") @db.Decimal(14, 3)
  /// 完工实际入库量
  outputQty   Decimal             @default(0) @map("output_qty") @db.Decimal(14, 3)
  /// 领料来源地点
  sourceLocationId  String        @map("source_location_id")
  /// 成品入库地点（必须是自有仓）
  outputLocationId  String        @map("output_location_id")
  /// 委外时填代工厂地点；为空表示自产
  factoryLocationId String?       @map("factory_location_id")
  status      ScmProductionStatus @default(APPROVED)
  /// 成品批号与效期
  batchNo        String    @default("") @map("batch_no")
  productionDate DateTime? @map("production_date")
  expiryDate     DateTime? @map("expiry_date")
  /// 代工厂加工费（元）
  processingFee  Decimal   @default(0) @map("processing_fee") @db.Decimal(12, 2)
  /// 参考材料成本（按组件采购价估算）
  materialCost   Decimal   @default(0) @map("material_cost") @db.Decimal(12, 2)
  totalCost      Decimal   @default(0) @map("total_cost") @db.Decimal(12, 2)
  unitCost       Decimal   @default(0) @map("unit_cost") @db.Decimal(14, 6)
  remark         String    @default("") @db.VarChar(500)
  createdBy      String    @default("") @map("created_by")
  createdByName  String    @default("") @map("created_by_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product ScmProduct          @relation(fields: [productId], references: [id])
  items   ScmProductionItem[]

  @@index([orgId, status])
  @@index([productId])
  @@index([createdAt])
  @@map("scm_production_orders")
}

model ScmProductionItem {
  id          String  @id @default(cuid())
  orderId     String  @map("order_id")
  componentId String  @map("component_id")
  name        String
  spec        String  @default("")
  unit        String  @default("")
  qtyPerUnit  Decimal @default(0) @map("qty_per_unit") @db.Decimal(14, 6)
  lossRate    Decimal @default(0) @map("loss_rate") @db.Decimal(6, 4)
  /// 按计划产量算出的应领量
  requiredQty Decimal @default(0) @map("required_qty") @db.Decimal(14, 3)
  /// 实际领用/发料量
  issuedQty   Decimal @default(0) @map("issued_qty") @db.Decimal(14, 3)
  /// 参考单价（组件采购价快照）
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(14, 6)
  amount      Decimal @default(0) @db.Decimal(12, 2)

  order     ScmProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  component ScmProduct         @relation(fields: [componentId], references: [id])

  @@index([orderId])
  @@index([componentId])
  @@map("scm_production_items")
}

/// 采购价来源：手工维护或验收入库自动记录
enum ScmPriceSource {
  MANUAL
  RECEIPT
}

/// 采购价历史。同一商品不同供应商、不同时期可以有多个价格，
/// 成本核算取「生效日期不晚于业务日期」的最新一条。
model ScmPurchasePrice {
  id            String          @id @default(cuid())
  productId     String          @map("product_id")
  /// 为空表示未指定供应商的通用价
  supplierId    String?         @map("supplier_id")
  price         Decimal         @db.Decimal(12, 2)
  effectiveFrom DateTime        @default(now()) @map("effective_from") @db.Date
  source        ScmPriceSource  @default(MANUAL)
  /// 来源单号（验收单号等）
  ref           String          @default("")
  remark        String          @default("") @db.VarChar(500)
  createdBy     String          @default("") @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")

  product  ScmProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier ScmSupplier? @relation(fields: [supplierId], references: [id])

  @@index([productId, effectiveFrom])
  @@index([supplierId])
  @@map("scm_purchase_prices")
}

/// 批次库存：同一地点同一商品按批号分开记账，出库按先到期先出。
/// 期初结存由迁移脚本补一批「期初」批次，保证批次数量与结存一致。
model ScmStockBatch {
  id             String    @id @default(cuid())
  warehouseId    String    @map("warehouse_id")
  ownerOrgId     String    @default("") @map("owner_org_id")
  productId      String    @map("product_id")
  batchNo        String    @default("") @map("batch_no")
  productionDate DateTime? @map("production_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  /// 剩余数量
  qty            Decimal   @default(0) @db.Decimal(14, 3)
  /// 该批实际单位成本：采购价 / 生产完工单位成本 / 调拨带来的原批成本
  unitCost       Decimal   @default(0) @map("unit_cost") @db.Decimal(14, 6)
  /// 来源类型：RECEIPT / TRANSFER / PRODUCTION / ADJUST / OPENING
  sourceType     String    @default("") @map("source_type")
  sourceNo       String    @default("") @map("source_no")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product ScmProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([warehouseId, productId, expiryDate])
  @@index([expiryDate])
  @@index([productId])
  @@map("scm_stock_batches")
}

/// 供货方类型
enum PurchaseSupplierType {
  EXTERNAL // 外部供应商
  HQ // 总部（门店向总部订货）
}

enum PurchaseOrderStatus {
  PENDING_APPROVAL // 审批中
  REJECTED // 已驳回
  APPROVED // 待收货
  PARTIAL // 部分入库
  COMPLETED // 已完成
  CANCELLED // 已取消
}

/// 采购订单
model PurchaseOrder {
  id           String               @id // 可读单号 PO+日期+序号
  /// 采购方组织（总部向外采购，或门店向总部订货）
  buyerId      String               @map("buyer_id")
  supplierType PurchaseSupplierType @map("supplier_type")
  supplierId   String?              @map("supplier_id")
  /// 下单时的供货方名称快照
  supplierName String               @default("") @map("supplier_name")

  totalAmount Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  status      PurchaseOrderStatus @default(PENDING_APPROVAL)

  createdBy     String @default("") @map("created_by") // 发起人登录名
  createdByName String @default("") @map("created_by_name")
  remark        String @default("") @db.VarChar(500)

  /// 关联审批实例；为空表示未命中流程，免审直接生效
  approvalId String? @map("approval_id")
  flowName   String  @default("") @map("flow_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]
  supplier ScmSupplier?        @relation(fields: [supplierId], references: [id])

  @@index([buyerId, status])
  @@index([createdAt])
  @@map("purchase_orders")
}

/// 采购明细（商品名/规格/单位下单时快照，主数据改名不影响历史单）
model PurchaseOrderItem {
  id          String  @id @default(cuid())
  orderId     String  @map("order_id")
  productId   String  @map("product_id")
  name        String
  spec        String  @default("")
  unit        String  @default("")
  price       Decimal @default(0) @db.Decimal(10, 2)
  qty         Decimal @default(0) @db.Decimal(14, 3)
  /// 已验收入库数量，支持分批入库累加
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(14, 3)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("purchase_order_items")
}

/// 验收入库单
model GoodsReceipt {
  id          String  @id // 可读单号 GR+日期+序号
  poId        String  @map("po_id")
  /// 收货地点（自有仓或供应商处）
  warehouseId String  @map("warehouse_id")
  /// 物权归属组织
  ownerOrgId  String  @default("") @map("owner_org_id")
  /// 本次验收是否存在差异（少收/拒收）
  hasDiff     Boolean @default(false) @map("has_diff")

  operator     String   @default("") // 验收人登录名
  operatorName String   @default("") @map("operator_name")
  createdAt    DateTime @default(now()) @map("created_at")

  items GoodsReceiptItem[]
  order PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([warehouseId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id         String @id @default(cuid())
  receiptId  String @map("receipt_id")
  productId  String @map("product_id")
  name       String
  unit       String @default("")
  orderedQty Decimal @default(0) @map("ordered_qty") @db.Decimal(14, 3)
  /// 本次实收
  acceptQty  Decimal @default(0) @map("accept_qty") @db.Decimal(14, 3)
  /// 本次拒收/差异
  rejectQty  Decimal @default(0) @map("reject_qty") @db.Decimal(14, 3)
  reason     String @default("") @db.VarChar(500)
  /// 批次与效期（可选）
  batchNo        String    @default("") @map("batch_no")
  productionDate DateTime? @map("production_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("goods_receipt_items")
}

/// 库存结存：地点 × 商品 唯一
model StockBalance {
  id          String  @id @default(cuid())
  /// 库存地点 id（自有仓即仓库组织 id）
  warehouseId String  @map("warehouse_id")
  /// 物权归属组织，行级数据范围按此字段过滤
  ownerOrgId  String  @default("") @map("owner_org_id")
  productId   String  @map("product_id")
  qty         Decimal @default(0) @db.Decimal(14, 3)

  updatedAt DateTime @updatedAt @map("updated_at")

  product ScmProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("stock_balances")
}

enum StockLedgerType {
  IN
  OUT
  ADJUST
}

/// 库存变动流水（只进不改，与结存同事务写入）
model StockLedger {
  id          String          @id @default(cuid())
  /// 库存地点 id（自有仓即仓库组织 id）
  warehouseId String          @map("warehouse_id")
  /// 物权归属组织
  ownerOrgId  String          @default("") @map("owner_org_id")
  productId   String          @map("product_id")
  type        StockLedgerType
  /// 正数为增、负数为减
  qty         Decimal         @db.Decimal(14, 3)
  /// 批次号，出库按批次拆分时每批一条流水
  batchNo     String          @default("") @map("batch_no")
  /// 来源单据号或说明
  ref         String          @default("")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([warehouseId, productId])
  @@index([createdAt])
  @@map("stock_ledgers")
}

enum StockAdjustReason {
  PROFIT // 盘盈
  LOSS // 盘亏
  DAMAGE // 报损
  OTHER
}

enum StockAdjustStatus {
  PENDING_APPROVAL
  REJECTED
  EFFECTIVE // 已生效（已写入库存）
  CANCELLED
}

/// 库存调整单：盘盈盘亏/报损，走审批，通过后才写入库存
model StockAdjust {
  id          String            @id // 可读单号 SA+日期+序号
  /// 盘点地点 id
  warehouseId String            @map("warehouse_id")
  /// 物权归属组织
  ownerOrgId  String            @default("") @map("owner_org_id")
  reason      StockAdjustReason @default(OTHER)
  remark      String            @default("") @db.VarChar(500)
  /// 影响金额（按供货价估算的绝对值），用于命中金额分级
  totalAmount Decimal           @default(0) @map("total_amount") @db.Decimal(12, 2)
  status      StockAdjustStatus @default(PENDING_APPROVAL)

  createdBy     String @default("") @map("created_by")
  createdByName String @default("") @map("created_by_name")

  approvalId String? @map("approval_id")
  flowName   String  @default("") @map("flow_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items StockAdjustItem[]

  @@index([warehouseId, status])
  @@map("stock_adjusts")
}

model StockAdjustItem {
  id        String  @id @default(cuid())
  adjustId  String  @map("adjust_id")
  productId String  @map("product_id")
  name      String
  unit      String  @default("")
  /// 调整前账面数（录入时快照）
  beforeQty Decimal @default(0) @map("before_qty") @db.Decimal(14, 3)
  /// 调整后实际数
  afterQty  Decimal @default(0) @map("after_qty") @db.Decimal(14, 3)
  /// 差额 = 后 - 前，正为盘盈
  diffQty   Decimal @default(0) @map("diff_qty") @db.Decimal(14, 3)
  price     Decimal @default(0) @db.Decimal(10, 2)

  adjust StockAdjust @relation(fields: [adjustId], references: [id], onDelete: Cascade)

  @@index([adjustId])
  @@map("stock_adjust_items")
}

// ========== 财务 ==========

/// 收入数据源：各业务系统的口径统一抽到本系统
enum RevenueSourceKey {
  SELF // 本系统（福愈小程序）
  ONSITE // 在场系统（到店收银）
  QINGLIAO // 轻疗系统
  MANUAL // 手工补录
}

enum RevenueSourceStatus {
  CONNECTED // 已打通
  PENDING // 待打通
  MANUAL // 人工兼容
}

/// 数据源接入状态配置（一源一行，供收入页展示与手动触发抽数）
model RevenueSourceConfig {
  key        RevenueSourceKey    @id
  name       String
  intro      String              @default("") @db.VarChar(500)
  status     RevenueSourceStatus @default(PENDING)
  /// 抽数方式说明
  mode       String              @default("")
  /// 同步频率说明
  cron       String              @default("")
  lastSyncAt DateTime?           @map("last_sync_at")
  note       String              @default("") @db.VarChar(500)
  sortOrder  Int                 @default(0) @map("sort_order")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@map("revenue_source_configs")
}

enum RevenueWay {
  AUTO // 接口自动
  IMPORT // 手工导入
  MANUAL // 手工录入
}

/// 收入流水：按 月份 × 核算组织 × 数据源 入账，看板实时聚合不存结果
model RevenueRecord {
  id         String           @id @default(cuid())
  /// 核算月份 yyyy-MM
  month      String
  orgId      String           @map("org_id")
  source     RevenueSourceKey
  amount     Decimal          @default(0) @db.Decimal(12, 2)
  /// 对应单量，仅供展示
  orderCount Int              @default(0) @map("order_count")
  way        RevenueWay       @default(MANUAL)
  remark     String           @default("") @db.VarChar(500)
  /// 自动抽数时的幂等键：同一源同一月同一组织只留一条自动汇总
  syncKey    String?          @map("sync_key")

  syncAt    DateTime @default(now()) @map("sync_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([syncKey])
  @@index([month, orgId])
  @@index([source, month])
  @@map("revenue_records")
}

/// 人工录入类支出科目。房租与物业费不在此列，它们按门店租金参数现算。
enum ExpenseCategory {
  LABOR // 人力成本
  MEITUAN // 美团推广费
  OTHER // 其他支出
}

enum ExpenseSource {
  MANUAL // 手工录入
  IMPORT // 批量导入
}

enum ExpenseStatus {
  PENDING_APPROVAL // 审批中（不计入看板）
  EFFECTIVE // 已生效
  REJECTED // 已驳回
}

/// 月度支出录入（房租/人力/美团推广费/其他）
/// 管理费、培训费按组织比例由看板现算；耗材支出由采购单汇总，均不在此表
model ExpenseEntry {
  id       String          @id @default(cuid())
  orgId    String          @map("org_id")
  month    String
  category ExpenseCategory
  /// 自定义名称（OTHER 类使用）
  name     String          @default("")
  amount   Decimal         @default(0) @db.Decimal(12, 2)
  source   ExpenseSource   @default(MANUAL)
  remark   String          @default("") @db.VarChar(500)
  status   ExpenseStatus   @default(EFFECTIVE)

  approvalId String? @map("approval_id")
  flowName   String  @default("") @map("flow_name")

  createdBy     String @default("") @map("created_by")
  createdByName String @default("") @map("created_by_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([month, orgId])
  @@index([status])
  @@map("expense_entries")
}

// ========== 社群（国内版 Skool） ==========

/// 社群审核状态：创建/修改后需平台审核通过才上架广场
enum CommunityStatus {
  PENDING // 待审核
  APPROVED // 已通过
  REJECTED // 已驳回
}

/// 主理人角色：基础=首个社群免费，最多 1 个；扩展=平台人工开通，可多个
enum CommunityHostRole {
  BASIC
  EXTENDED
}

/// 广场可见性
enum CommunityVisibility {
  PUBLIC // 广场 + 链接
  HIDDEN // 仅链接，不进广场
  INVITE_ONLY // 仅邀请访问
}

/// 入群方式
enum CommunityJoinMode {
  OPEN // 直接加入
  APPROVAL // 申请审核
  INVITE // 仅限邀请
}

/// 成员活动展示隐私（每个社群独立设置）
enum CommunityPrivacy {
  NONE // 不展示活动
  COMPLETED // 只展示已完成的活动
  ALL // 展示全部活动（含未开始）
}

/// 活动可见范围
enum CommunityEventScope {
  PUBLIC // 公开（社群外可见）
  INTERNAL // 成员专属
}

/// 邀请类型
enum CommunityInviteKind {
  NORMAL // 普通邀请
  WAIVER // 免年费
  REDUCE // 固定金额减免
}

/// 入群申请状态
enum CommunityRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// 社群活动形式：线下课程 / 直播 / 线上（会议等）
enum CommunityEventType {
  OFFLINE // 线下课程/活动
  LIVE // 直播
  ONLINE // 线上
}

/// 社群动态审核状态（发帖先审后发）
enum CommunityPostStatus {
  PENDING // 待审核
  APPROVED // 已发布
  REJECTED // 已驳回
}

/// 社群（主理人可创建多个；入会主口径年费，单位：分）
model Community {
  id       String          @id @default(cuid())
  name     String
  slogan   String          @default("") @db.VarChar(200)
  category String          @default("疗愈")
  /// 16:9 封面（主理人上传，存 URL）
  coverUrl      String? @map("cover_url") @db.LongText
  coverFallback String? @default("linear-gradient(135deg, #6D5934 0%, #A78E70 100%)") @map("cover_fallback")
  ownerName     String    @default("") @map("owner_name")
  ownerTitle    String?   @map("owner_title")
  ownerAvatar   String?   @map("owner_avatar") @db.LongText
  /// 主理人小程序用户 id（可空：官方社群由平台直管）
  ownerUserId String?  @map("owner_user_id")
  memberCount Int      @default(0) @map("member_count")
  /// 年费（分），0 = 免费
  yearlyFee   Int      @default(0) @map("yearly_fee")
  isOfficial  Boolean  @default(false) @map("is_official")
  /// 内部运营字段：新社群排序加权用，不面向 C 端展示
  isNew       Boolean  @default(false) @map("is_new")
  /// 标签 JSON 数组，如 ["身心疗愈","正念"]（MySQL TEXT 列不能带默认值，服务端创建时默认写入 "[]"）
  tags        String   @db.Text
  description String?  @db.Text
  status      CommunityStatus @default(PENDING)
  isActive    Boolean  @default(true) @map("is_active")
  /// 近 30 天新增成员（内部排序加权用）
  growth30d   Int      @default(0) @map("growth_30d")
  /// 今日活跃成员数（广场展示用）
  activeToday Int      @default(0) @map("active_today")
  /// 广场可见性
  visibility CommunityVisibility @default(PUBLIC)
  /// 入群方式
  joinMode   CommunityJoinMode   @default(OPEN) @map("join_mode")
  /// 兴趣池 JSON 数组，最多 12 项
  interestPool String? @db.Text @map("interest_pool")
  /// 分享视觉配置 JSON：{source,palette,layout,imageUrl,updatedAt}
  shareArtwork String? @db.Text @map("share_artwork")
  /// 订阅制代结算协议：主理人勾选的协议版本号（免费社群为空）
  settlementAgreementVersion String?   @map("settlement_agreement_version") @db.VarChar(32)
  /// 订阅制代结算协议勾选时间
  settlementAgreedAt         DateTime? @map("settlement_agreed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events         CommunityEvent[]
  posts          CommunityPost[]
  joins          CommunityJoin[]
  orders         Order[]
  joinRequests   CommunityJoinRequest[]
  invites        CommunityInvite[]
  inviteClaims   CommunityInviteClaim[]
  comments       CommunityComment[]
  moderationLogs CommunityModerationLog[]
  eventSignups   CommunityEventSignup[]
  postLikes      CommunityPostLike[]

  @@index([status, isActive])
  @@map("communities")
}

/// 社群活动（活动日历数据源；官方课程活动可关联 Course 直接跳转报名）
model CommunityEvent {
  id          String             @id @default(cuid())
  communityId String             @map("community_id")
  eventDate   DateTime           @db.Date @map("event_date")
  /// 开始时间，如 "20:00"
  time        String             @default("")
  /// 结束时间，如 "21:00"；用于识别当日已结束活动
  endTime     String?            @map("end_time") @db.VarChar(10)
  title       String
  type        CommunityEventType @default(OFFLINE)
  venue       String? // 线下场地
  capacity    Int                @default(0)
  joined      Int                @default(0)
  /// 关联官方课程 id（存在时 C 端点击跳转课程页报名）
  courseId    String?            @map("course_id")
  /// 可见范围：公开 / 成员专属
  scope       CommunityEventScope @default(PUBLIC)
  isActive    Boolean            @default(true) @map("is_active")
  description String?            @db.Text
  /// 分享视觉配置 JSON：{source,palette,layout,imageUrl,updatedAt}
  shareArtwork String?           @db.Text @map("share_artwork")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  signups   CommunityEventSignup[]

  @@index([communityId, eventDate])
  @@map("community_events")
}

/// 社群动态（先审后发；作者信息为发布时快照）
model CommunityPost {
  id           String              @id @default(cuid())
  communityId  String              @map("community_id")
  authorId     String?             @map("author_id")
  authorName   String              @default("") @map("author_name")
  authorAvatar String?             @map("author_avatar") @db.LongText
  /// 主理人 | 成员
  authorRole   String              @default("成员") @map("author_role")
  authorLevel  Int                 @default(1) @map("author_level")
  content      String              @db.Text
  /// 配图 JSON 数组
  images       String?             @db.Text
  likes        Int                 @default(0)
  comments     Int                 @default(0)
  status       CommunityPostStatus @default(PENDING)
  /// 后期治理：隐藏后 C 端不可见，后台可恢复
  isHidden     Boolean             @default(false) @map("is_hidden")
  /// 删除为软删除，保留治理留痕
  isDeleted    Boolean             @default(false) @map("is_deleted")
  hiddenReason String?             @map("hidden_reason") @db.Text
  moderatedAt  DateTime?           @map("moderated_at")
  moderatedBy  String?             @map("moderated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community    Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  commentsList CommunityComment[]
  likesList    CommunityPostLike[]

  @@index([communityId, status])
  @@map("community_posts")
}

/// 社群动态点赞（一人一赞，取消即删除；posts.likes 作为冗余计数同步维护）
model CommunityPostLike {
  id          String   @id @default(cuid())
  postId      String   @map("post_id")
  communityId String   @map("community_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  community Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([communityId, userId])
  @@map("community_post_likes")
}

/// 社群加入关系（我加入的/成员列表数据源）
model CommunityJoin {
  id          String    @id @default(cuid())
  communityId String    @map("community_id")
  userId      String    @map("user_id")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  /// 付费社群有效期；null 表示免费社群或历史免费加入
  paidUntil   DateTime? @map("paid_until")
  /// 活动展示隐私（每个社群独立设置）
  privacy     CommunityPrivacy @default(NONE)
  /// 成员选择的兴趣标签 JSON 数组，最多 3 项
  interests   String?   @db.Text
  /// 权益来源：PAID/FREE/WAIVER/COUPON/INVITE/PLATFORM
  source      String    @default("PAID") @db.VarChar(20)
  /// 0 元入群/邀请入群时关联的订单，作为权益凭证
  orderId     String?   @map("order_id")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@map("community_joins")
}

/// 入群申请（仅入群审核；动态与评论不做发布前审核）
model CommunityJoinRequest {
  id             String                 @id @default(cuid())
  communityId    String                 @map("community_id")
  userId         String                 @map("user_id")
  note           String?                @db.Text
  status         CommunityRequestStatus @default(PENDING)
  reviewedBy     String?                @map("reviewed_by")
  reviewedByName String?                @map("reviewed_by_name")
  reviewNote     String?                @map("review_note") @db.Text
  reviewedAt     DateTime?              @map("reviewed_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, status])
  @@map("community_join_requests")
}

/// 邀请/礼遇：普通邀请不附赠权益；WAIVER=免年费；REDUCE=固定金额减免
model CommunityInvite {
  id          String              @id @default(cuid())
  communityId String              @map("community_id")
  name        String              @db.VarChar(120)
  kind        CommunityInviteKind @default(NORMAL)
  /// REDUCE 时的减免金额（分）；WAIVER 忽略
  amount      Int                 @default(0)
  /// null = 长期有效
  expiresAt   DateTime?           @map("expires_at")
  /// 0 = 不限名额
  quota       Int                 @default(0)
  usedCount   Int                 @default(0) @map("used_count")
  isActive    Boolean             @default(true) @map("is_active")
  note        String?             @db.Text
  createdBy   String?             @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  community Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  claims    CommunityInviteClaim[]

  @@index([communityId, isActive])
  @@map("community_invites")
}

/// 邀请领取记录：每人每张邀请仅可领取一次；仅可用于发行社群
model CommunityInviteClaim {
  id          String    @id @default(cuid())
  inviteId    String    @map("invite_id")
  communityId String    @map("community_id")
  userId      String    @map("user_id")
  claimedAt   DateTime  @default(now()) @map("claimed_at")
  usedAt      DateTime? @map("used_at")
  orderId     String?   @map("order_id")

  invite    CommunityInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  community Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@index([userId, communityId])
  @@map("community_invite_claims")
}

/// 社群动态评论（即时可见，后期治理）
model CommunityComment {
  id           String   @id @default(cuid())
  postId       String   @map("post_id")
  communityId  String   @map("community_id")
  authorId     String?  @map("author_id")
  authorName   String   @default("") @map("author_name")
  authorAvatar String?  @map("author_avatar") @db.LongText
  content      String   @db.Text
  isHidden     Boolean  @default(false) @map("is_hidden")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  hiddenReason String?  @map("hidden_reason") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  community Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("community_comments")
}

/// 内容治理日志（隐藏/恢复/删除均留痕）
model CommunityModerationLog {
  id          String   @id @default(cuid())
  communityId String   @map("community_id")
  /// POST | COMMENT
  targetType  String   @map("target_type") @db.VarChar(20)
  targetId    String   @map("target_id")
  /// HIDE | RESTORE | DELETE
  action      String   @db.VarChar(20)
  reason      String   @db.Text
  /// HOST | PLATFORM
  actorType   String   @map("actor_type") @db.VarChar(20)
  actorId     String?  @map("actor_id")
  actorName   String   @default("") @map("actor_name")
  createdAt   DateTime @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@map("community_moderation_logs")
}

/// 社群活动报名（未关联官方课程的活动使用）
model CommunityEventSignup {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  communityId String   @map("community_id")
  userId      String   @map("user_id")
  status      String   @default("SIGNED") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([communityId, userId])
  @@map("community_event_signups")
}

// ========== 在场财务台账 ==========
// 财务流水与业务交易流水分离：本表不建业务外键，只保存业务快照。
// 业务表仅作为生成输入，所有在场财务报表只读本台账。

/// 在场财务流水（独立实体，幂等重建，已关账月份不可变）
model PresenceFinanceEntry {
  id        String              @id @default(cuid())
  /// 幂等键：同一业务财务事件只入账一次
  dedupeKey String              @unique @map("dedupe_key") @db.VarChar(180)
  /// 归属会计月份 yyyy-MM
  month     String              @db.VarChar(7)
  /// 财务事件发生日（按日归集）
  entryDate DateTime            @map("entry_date") @db.Date
  /// CASH 现金 / REVENUE 收入 / TRAINER_COST 导师成本
  account   PresenceAccount
  /// CASH_IN 收款 / CASH_REFUND 退款 / RECOGNIZE 确认收入 / REVERSAL 冲减 / SETTLEMENT 导师结算
  eventType PresenceEventType   @map("event_type")
  /// COURSE 课程 / MEMBER_CARD 会员卡 / WAITLIST 候补 / COMMUNITY_FEE 社群手续费 / TRAINER 导师
  category  PresenceCategory
  /// 带符号金额（分）
  amountFen Int                 @map("amount_fen")

  // ---- 业务快照（无外键） ----
  orderId       String? @map("order_id")
  orderNo       String? @map("order_no")
  orderType     String? @map("order_type") @db.VarChar(20)
  courseId      String? @map("course_id")
  courseName    String? @map("course_name")
  memberCardId  String? @map("member_card_id")
  cardName      String? @map("card_name")
  communityId   String? @map("community_id")
  communityName String? @map("community_name")
  hostUserId    String? @map("host_user_id")
  hostName      String? @map("host_name") @db.VarChar(100)
  settlementId  String? @map("settlement_id")
  trainerId     String? @map("trainer_id")
  trainerName   String? @map("trainer_name") @db.VarChar(100)
  orgId         String? @map("org_id")
  orgName       String? @map("org_name") @db.VarChar(100)

  // ---- 服务期快照（确认类流水用） ----
  serviceStart DateTime? @map("service_start") @db.Date
  serviceEnd   DateTime? @map("service_end") @db.Date
  hours        Decimal?  @db.Decimal(10, 2)
  rate         Decimal?  @db.Decimal(10, 2)

  remark    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([month, account])
  @@index([month, category])
  @@index([month, entryDate])
  @@index([orderId])
  @@index([communityId])
  @@index([settlementId])
  @@index([orgId])
  @@map("presence_finance_entries")
}

enum PresenceAccount {
  CASH
  REVENUE
  TRAINER_COST
}

enum PresenceEventType {
  CASH_IN
  CASH_REFUND
  RECOGNIZE
  REVERSAL
  SETTLEMENT
}

enum PresenceCategory {
  COURSE
  MEMBER_CARD
  WAITLIST
  COMMUNITY_FEE
  TRAINER
}

/// 在场财务关账期间（自然月，自动关账后不可变）
model PresenceFinancePeriod {
  month     String               @id @db.VarChar(7)
  status    PresencePeriodStatus @default(OPEN)
  closedAt  DateTime?            @map("closed_at")
  closedBy  String?              @map("closed_by")
  remark    String?              @db.VarChar(255)
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@map("presence_finance_periods")
}

enum PresencePeriodStatus {
  OPEN
  CLOSED
}
