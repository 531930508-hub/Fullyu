{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["@dcloudio/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@fullyu/shared": ["../../packages/shared/src/index.ts"],
      "@fullyu/design-tokens": ["../../packages/design-tokens/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
