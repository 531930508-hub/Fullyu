// Full愈·时叙 数据库 Schema
// 开发用 SQLite；上线切 MySQL：provider 改 "mysql" 并将 Json 字段保持 Json（MySQL 原生支持）。
// 注意：时间一律 DateTime（SQLite 内为毫秒整数）；金额为整数分 Int。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========== 基础 ==========

model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

model Setting {
  key       String   @id
  valueJson String   @map("value_json")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// 首页轮播：图片本身是完整广告图，linkType/linkValue 只描述站内跳转。
model Banner {
  id        String   @id
  title     String
  imageUrl  String   @map("image_url")
  linkType  String   @map("link_type")
  linkValue String   @default("") @map("link_value")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

/// 首页系列图覆盖：key 为 xing-zh 等 8 个固定槽位；没有记录时小程序使用内置图。
model HomeAsset {
  key       String   @id
  imageUrl  String   @map("image_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("home_assets")
}

model Store {
  id            String   @id
  city          String
  cityEn        String   @map("city_en")
  name          String
  nameEn        String   @map("name_en")
  short         String
  address       String
  addressEn     String   @map("address_en")
  lat           Float
  lng           Float
  open          Boolean  @default(true)
  retailPickup  Boolean  @default(true) @map("retail_pickup")
  hours         String
  printerStatus String   @default("online") @map("printer_status")
  channelsJson  String   @map("channels_json")
  positionsJson String   @map("positions_json")
  waitMinutes   Int      @default(8) @map("wait_minutes")
  /// 门店劳务单价（分/分钟）。劳务工资 = 门店单价 × 实际工时，旧结算单保留快照单价
  laborRatePerMinCents Int @default(220) @map("labor_rate_per_min_cents")

  stock           Stock[]
  losses          Loss[]
  userStores      UserStore[]

  @@map("stores")
}

model Category {
  id     String @id
  name   String
  nameEn String @map("name_en")
  kind   String

  products Product[]

  @@map("categories")
}

model Product {
  id              String   @id
  name            String
  nameEn          String   @map("name_en")
  categoryId      String   @map("category_id")
  series          String
  kind            String // tea | retail | bottle
  priceCents      Int      @map("price_cents")
  costCents       Int      @map("cost_cents")
  doseG           Float    @map("dose_g")
  status          String // draft | published | archived
  tempsJson       String   @map("temps_json")
  ice             Boolean  @default(true)
  memberEligible  Boolean  @default(true) @map("member_eligible")
  descZh          String   @default("") @map("desc_zh")
  descEn          String   @default("") @map("desc_en")
  specZh          String   @default("") @map("spec_zh")
  specEn          String   @default("") @map("spec_en")
  tagZh           String   @default("") @map("tag_zh")
  tagEn           String   @default("") @map("tag_en")
  unitZh          String   @default("") @map("unit_zh")
  unitEn          String   @default("") @map("unit_en")
  // 后台上传的商品图（相对 uploads 的 key）；为空时小程序回退到内置系列插画。
  imageUrl        String   @default("") @map("image_url")
  // 总部默认排序：同系列同分类内生效，门店可用 Stock.sortOrder 覆盖。
  sortOrder       Int      @default(0) @map("sort_order")
  updatedAt       DateTime @map("updated_at")

  category   Category     @relation(fields: [categoryId], references: [id])
  stock      Stock[]
  orderItems OrderItem[]
  losses     Loss[]
  mappings   Mapping[]

  @@map("products")
}

model Stock {
  storeId   String  @map("store_id")
  productId String  @map("product_id")
  grams     Float   @default(0)
  soldOut   Boolean @default(false) @map("sold_out")
  // 门店自定义排序；null 表示跟随总部 Product.sortOrder。
  sortOrder Int?    @map("sort_order")

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([storeId, productId])
  @@map("stock")
}

model Mapping {
  id         String   @id
  externalId String   @unique @map("external_id")
  productId  String   @map("product_id")
  unit       String   @default("袋")
  factor     Float    @default(1)
  updatedAt  DateTime @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("mappings")
}

// ========== 账号与权限 ==========

model Role {
  id          String  @id
  name        String
  description String
  scope       String // ALL | STORES
  builtin     Boolean @default(false)
  permsJson   String  @map("perms_json")

  userRoles UserRole[]

  @@map("roles")
}

model User {
  id           String   @id
  name         String
  username     String   @unique
  passwordHash String   @map("password_hash")
  allStores    Boolean  @default(false) @map("all_stores")
  active       Boolean  @default(true)
  // 会话版本：改密 / 主动撤销时 +1，旧令牌立即失效（JWT 携带签发时的版本）。
  tokenVersion Int      @default(1) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")

  roles      UserRole[]
  userStores UserStore[]

  @@map("users")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserStore {
  userId  String @map("user_id")
  storeId String @map("store_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@map("user_stores")
}

model Customer {
  id         String   @id
  memberCode String   @unique @map("member_code")
  name       String   @default("茶客")
  // 手机号是顾客唯一身份：微信手机号授权后写入，同一号码永远对应同一顾客。
  phone      String?  @unique
  // 积分余额（全平台共享，不分门店）；入账规则待运营确认前保持只读展示。
  points     Int      @default(0)
  // 头像存储 key（由 AvatarStorageProvider 下发），对外序列化为可访问 URL。
  avatarKey  String?  @map("avatar_key")
  // 与在场一致：1=男 2=女 null=未填写
  gender     Int?
  birthday   DateTime?
  // 微信身份：由小程序 wx.login → code2session 写入；H5 环境下为空。
  openId     String?  @unique @map("open_id")
  unionId    String?  @map("union_id")
  // 顾客会话版本：安全整改时整体 +1，旧的会员码会话令牌一次性作废。
  sessionVersion Int      @default(1) @map("session_version")
  // 会员身份为权威数据：standard | annual；memberUntil 为空表示长期有效。
  // 会籍以 CRM 品牌卡为准：memberTier/memberUntil 是 CRM 卡状态的本地快照，crmCardState 存原始卡状态，
  // memberSyncedAt 记录快照时间，用于 5 分钟 TTL，避免每次请求都打 CRM。
  memberTier     String   @default("standard") @map("member_tier")
  memberUntil    DateTime? @map("member_until")
  crmCardState   String?  @map("crm_card_state")
  memberSyncedAt DateTime? @map("member_synced_at")
  // 最近一次与 CRM 对齐的资料版本号；CRM profileVersion 更新时按新值回写本地快照。
  crmProfileVersion Int  @default(0) @map("crm_profile_version")
  createdAt  DateTime @default(now()) @map("created_at")

  orders  Order[]
  coupons CustomerCoupon[]

  @@map("customers")
}

// ========== 优惠券 ==========

/// 券模板：由总部创建，可通用或限定品类/单品，带面额、门槛与有效期。
/// validFrom..validTo 是活动期（也是券的最晚可用期限）；validDays>0 时每张券按发放/领取时刻顺延 N 天，取两者较早。
model Coupon {
  id            String   @id
  title         String
  // all=全场通用；category=仅限指定商品品类；product=仅限指定单品
  scope         String   @default("all")
  categoryId    String?  @map("category_id")
  productId     String?  @map("product_id")
  amountCents   Int      @map("amount_cents")
  minSpendCents Int      @default(0) @map("min_spend_cents")
  validFrom     DateTime @map("valid_from")
  validTo       DateTime @map("valid_to")
  // 0=固定区间；>0=发放后 N 天有效（且不晚于 validTo）
  validDays     Int      @default(0) @map("valid_days")
  // 顾客能否在会员中心自助领取
  claimable     Boolean  @default(false)
  // 每人最多领取张数（仅自助领取生效）
  claimLimit    Int      @default(1) @map("claim_limit")
  active        Boolean  @default(true)
  note          String   @default("")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  issued  CustomerCoupon[]
  batches CouponBatch[]
  rules   CouponRule[]

  @@index([claimable, validTo])
  @@map("coupons")
}

/// 自动化发券规则：生日当天、注册后 N 天、沉睡 N 天三类。
/// config 为 JSON 文本（生日提前天数 / 注册后区间 / 沉睡天数与最少消费次数），避免频繁加列。
model CouponRule {
  id             String    @id
  couponId       String    @map("coupon_id")
  // birthday=生日；welcome=新客欢迎；winback=沉睡唤醒
  kind           String
  enabled        Boolean   @default(true)
  tier           String    @default("all")
  config         String    @default("{}")
  note           String    @default("")
  lastRunAt      DateTime? @map("last_run_at")
  lastRunIssued  Int       @default(0) @map("last_run_issued")
  lastRunSkipped Int       @default(0) @map("last_run_skipped")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  coupon Coupon           @relation(fields: [couponId], references: [id])
  issued CustomerCoupon[]

  @@index([enabled])
  @@map("coupon_rules")
}

/// 发券批次：一次发放动作的可追溯记录，发券记录与撤回都以批次为单位。
/// 幂等键 requestKey 保证运营重复点击只会产生一个批次。
model CouponBatch {
  id           String   @id
  couponId     String   @map("coupon_id")
  // manual=按手机号；segment=按会员条件；all=全部会员
  source       String
  // 目标人数 / 成功张数 / 跳过人数
  requested    Int      @default(0)
  issued       Int      @default(0)
  skipped      Int      @default(0)
  // 当时的筛选条件快照（JSON 文本），用于复盘「这批发给了谁」
  filter       String   @default("")
  requestKey   String   @unique @map("request_key")
  note         String   @default("")
  operatorId   String?  @map("operator_id")
  operatorName String   @default("") @map("operator_name")
  createdAt    DateTime @default(now()) @map("created_at")

  coupon  Coupon           @relation(fields: [couponId], references: [id])
  records CustomerCoupon[]

  @@index([couponId, createdAt])
  @@map("coupon_batches")
}

/// 顾客持券实例：available 可用 / reserved 已锁单待支付 / used 已使用 / revoked 已作废。
/// 每张券落库时就固化 validFrom..validTo（发放后 N 天或券模板区间，取较早），
/// 并快照会员等级、入会时间与累计消费单数，保证「发放时谁、处于什么等级」可回溯。
model CustomerCoupon {
  id           String    @id
  couponId     String    @map("coupon_id")
  customerId   String    @map("customer_id")
  batchId      String?   @map("batch_id")
  status       String    @default("available")
  issuedAt     DateTime  @default(now()) @map("issued_at")
  // 本张券的实际可用区间（由发放时刻与模板规则计算，之后不随模板改动）
  validFrom    DateTime  @map("valid_from")
  validTo      DateTime  @map("valid_to")
  usedAt       DateTime? @map("used_at")
  orderId      String?   @map("order_id")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String    @default("") @map("revoke_reason")
  revokedBy    String?   @map("revoked_by")
  // 发券时会员快照
  memberTier   String    @default("") @map("member_tier")
  memberSince  DateTime? @map("member_since")
  orderCount   Int       @default(0) @map("order_count")
  // 自动规则来源：同一规则同一周期（生日年份/月份/once）对同一会员只发一次
  ruleId       String?   @map("rule_id")
  rulePeriod   String    @default("") @map("rule_period")

  coupon   Coupon       @relation(fields: [couponId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  batch    CouponBatch? @relation(fields: [batchId], references: [id])
  rule     CouponRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([ruleId, customerId, rulePeriod])
  @@index([customerId, status])
  @@index([couponId, customerId])
  @@index([couponId, validTo])
  @@index([batchId, status])
  @@map("customer_coupons")
}

// ========== 订单 ==========

model Order {
  id            String    @id
  number        String    @unique
  business      String // fresh | retail
  storeId       String    @map("store_id")
  channel       String // mini | assisted | meituan | taobao
  type          String // dine | takeaway | delivery | retail
  seat          String?
  status        String // unpaid | pending | ready | delivered | refunded | cancelled
  paymentStatus String    @default("unpaid") @map("payment_status")
  totalCents    Int       @map("total_cents")
  refundedCents Int       @default(0) @map("refunded_cents")
  // 优惠券抵扣：下单时由服务端核验并计算，券实例随之锁定，支付成功后标记已用。
  couponId            String? @map("coupon_id")
  couponTitle         String? @map("coupon_title")
  couponDiscountCents Int     @default(0) @map("coupon_discount_cents")
  // 自带杯优惠：只由营业台代点声明（顾客自带杯），按杯数逐杯减免，金额已分摊进订单行。
  byoCupCups          Int     @default(0) @map("byo_cup_cups")
  byoCupDiscountCents Int     @default(0) @map("byo_cup_discount_cents")
  // 年卡会员每杯立减：服务端按库内会籍与 CRM 权益计算，金额已分摊进订单行，并作为 CRM savedCents 上报。
  memberDiscountPerCupCents Int @default(0) @map("member_discount_per_cup_cents")
  memberDiscountCups        Int @default(0) @map("member_discount_cups")
  memberDiscountCents       Int @default(0) @map("member_discount_cents")
  pickupCode    String?   @map("pickup_code")
  pickupStoreId String?   @map("pickup_store_id")
  printStatus   String    @default("pending") @map("print_status")
  parentOrderId String?   @map("parent_order_id")
  note          String    @default("")
  customerId    String?   @map("customer_id")
  ownerKind     String    @default("customer") @map("owner_kind")
  createdBy     String?   @map("created_by")
  paymentRef    String?   @map("payment_ref")
  paymentMethod String?   @map("payment_method")
  preparedAt    DateTime? @map("prepared_at")
  createdAt     DateTime  @map("created_at")
  paidAt        DateTime? @map("paid_at")
  deliveredAt   DateTime? @map("delivered_at")
  refundPending Boolean   @default(false) @map("refund_pending")

  // storeId 允许为 'brand'（品牌零售 / 总部），因此不设外键，仅保留字符串标识。
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  units    OrderUnit[]
  finance  FinanceEntry[]
  printJobs PrintJob[]

  @@index([storeId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id
  orderId        String  @map("order_id")
  productId      String  @map("product_id")
  name           String
  nameEn         String  @map("name_en")
  kind           String
  series         String
  qty            Int
  sortOrder      Int     @default(0) @map("sort_order")
  refundedQty    Int     @default(0) @map("refunded_qty")
  // 已被退款意图原子占用的数量：外部退款调用前先占用，成功转 refundedQty，失败释放。
  pendingRefundQty Int   @default(0) @map("pending_refund_qty")
  unitPriceCents Int     @map("unit_price_cents")
  totalCents     Int     @map("total_cents")
  costCents      Int     @map("cost_cents")
  // 该行里享受自带杯减免的杯数与该行减免金额，便于对账与退款口径复核。
  byoCupQty           Int @default(0) @map("byo_cup_qty")
  byoCupDiscountCents Int @default(0) @map("byo_cup_discount_cents")
  // 该行年卡会员立减金额，已从 totalCents 扣掉；退款按实付比例分摊时天然包含。
  memberDiscountCents Int @default(0) @map("member_discount_cents")
  temp           String?
  ice            String?

  order  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])
  units   OrderUnit[]

  @@map("order_items")
}

model OrderUnit {
  id        String    @id
  orderId   String    @map("order_id")
  itemId    String    @map("item_id")
  label     String    @unique
  status    String    @default("pending") // pending | scanned | ready | refunded
  scannedAt DateTime? @map("scanned_at")

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  OrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("order_units")
}

// ========== 财务 ==========

model FinanceEntry {
  id          String   @id
  orderId     String?  @map("order_id")
  storeId     String   @map("store_id")
  type        String // SALE | REFUND
  amountCents Int      @map("amount_cents")
  method      String
  settlement  String
  memo        String   @default("")
  costCents   Int      @default(0) @map("cost_cents")
  dedupeKey   String   @unique @map("dedupe_key")
  at          DateTime

  order Order? @relation(fields: [orderId], references: [id])

  @@index([storeId, at])
  @@map("finance_entries")
}

model Expense {
  id          String    @id
  storeId     String    @map("store_id") // brand = 品牌零售/总部
  category    String
  amountCents Int       @map("amount_cents")
  at          String // YYYY-MM-DD 发生日期
  memo        String    @default("")
  source      String // manual | import | seed
  batchId     String?   @map("batch_id")
  // 源行唯一键（导入批次+行号+内容指纹）：数据库层防重复导入；手工录入为空。
  sourceKey   String?   @unique @map("source_key")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @map("created_at")
  voidedAt    DateTime? @map("voided_at")
  voidedBy    String?   @map("voided_by")

  @@index([storeId, at])
  @@map("expenses")
}

model Loss {
  id           String    @id
  storeId      String    @map("store_id")
  productId    String    @map("product_id")
  name         String
  kind         String
  qty          Float
  unit         String
  amountCents  Int       @map("amount_cents")
  reason       String
  note         String    @default("")
  status       String // pending | approved | rejected
  reportedBy   String?   @map("reported_by")
  decidedBy    String?   @map("decided_by")
  decidedAt    DateTime? @map("decided_at")
  decisionNote String    @default("") @map("decision_note")
  approvalId   String?   @map("approval_id")
  at           DateTime

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([storeId, at])
  @@map("losses")
}

model Approval {
  id          String    @id
  kind        String // refund | loss | remake
  status      String // pending | approved | rejected（决策状态）
  // 执行状态：批准 ≠ 已退钱；退款执行单独跟踪，失败可重试且不重复审批。
  executionStatus String @default("") @map("execution_status") // '' | pending | succeeded | failed | unknown
  refundIntentId  String? @map("refund_intent_id")
  amountCents Int       @map("amount_cents")
  storeId     String?   @map("store_id")
  orderId     String?   @map("order_id")
  summary     String
  payloadJson String    @map("payload_json")
  requestedBy String?   @map("requested_by")
  decidedBy   String?   @map("decided_by")
  comment     String    @default("")
  resultNote  String    @default("") @map("result_note")
  createdAt   DateTime  @map("created_at")
  decidedAt   DateTime? @map("decided_at")

  @@index([status, createdAt])
  @@map("approvals")
}

model Log {
  id        String   @id
  actorId   String?  @map("actor_id")
  actorName String?  @map("actor_name")
  action    String
  detail    String   @default("")
  type      String   @default("")
  storeId   String?  @map("store_id")
  orderId   String?  @map("order_id")
  at        DateTime

  @@index([at])
  @@map("logs")
}

model PrintJob {
  id          String   @id
  orderId     String   @map("order_id")
  kind        String
  // 稳定业务键：同一订单的自动出票任务只允许存在一条，重复回调不会重复入队。
  businessKey String   @unique @map("business_key")
  payloadJson String   @map("payload_json")
  status      String // queued | processing | printed | failed
  // 处理租约：领取时写入，超时未回写可安全恢复。
  claimedAt   DateTime? @map("claimed_at")
  attempts    Int      @default(0)
  lastError   String?  @map("last_error")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("print_jobs")
}

// 支付意图：下单/收款贯穿重试的幂等锚点。同键同内容重试返回同一单；网关未知结果可查询收敛。
model PaymentIntent {
  id           String   @id
  key          String   @unique // 客户端幂等键（或服务端生成的首次请求键）
  fingerprint  String // 请求内容指纹；同键异内容视为冲突
  status       String // processing | succeeded | failed | unknown
  orderId      String?  @map("order_id")
  storeId      String   @map("store_id")
  amountCents  Int      @map("amount_cents")
  method       String?
  providerRef  String?  @map("provider_ref")
  failReason   String?  @map("fail_reason")
  responseJson String?  @map("response_json") // 终态响应快照，用于幂等重放
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@map("payment_intents")
}

// 退款意图：先持久化并原子占用可退数量，再调外部网关；稳定退款单号支撑渠道幂等与对账。
model RefundIntent {
  id          String   @id // 稳定退款单号（RF-…），重试复用同一号
  orderId     String   @map("order_id")
  status      String // occupied | processing | succeeded | failed | released | unknown
  amountCents Int      @map("amount_cents")
  linesJson   String   @map("lines_json") // 占用的行明细 [{itemId, qty, amountCents, costCents}]
  approvalId  String?  @map("approval_id")
  requestedBy String?  @map("requested_by")
  decidedBy   String?  @map("decided_by")
  reason      String   @default("")
  providerRef String?  @map("provider_ref")
  failReason  String?  @map("fail_reason")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@index([orderId])
  @@map("refund_intents")
}

model IdempotencyKey {
  key         String   @id
  responseJson String  @map("response_json")
  createdAt   DateTime @map("created_at")

  @@map("idempotency_keys")
}

// ========== 品牌会员卡（Full愈年卡/月卡）购卡 ==========

/// 会员卡订单：小程序自助购卡的本地账本，也是渠道商户单号（MB-…）的持有者。
///
/// 设计要点：
/// - id 即渠道 order_id，回调/查询只按它找回本单，不信任回调里的门店、金额以外信息；
/// - 金额只取下单时 CRM 服务端报价（quoteId + priceCents），客户端传价一律忽略；
/// - 收款走门店同一条 JSAPI 渠道（store_id=brand 走服务商主商户号），资金落到品牌账户；
/// - 收款与开卡分开记账：pay_status 回答「钱到没到」，issue_status 回答「卡开没开」；
/// - 钱到了但开卡没确认（issue_status=unknown）由后台按退避自动重试，直到 CRM 确认开卡：
///   开卡带稳定 orderRef + 幂等键，CRM 按单号去重，重放只会拿回同一张卡，不会重复扣费或续期。
model BrandCardOrder {
  id             String    @id
  customerId     String    @map("customer_id")
  productCode    String    @map("product_code")
  productName    String    @default("") @map("product_name")
  amountCents    Int       @map("amount_cents")
  storeId        String    @default("brand") @map("store_id")
  // CRM 报价凭证：开卡时原样回传，CRM 据它锁定当时价格与时长。
  quoteId        String    @map("quote_id")
  quoteExpiresAt DateTime? @map("quote_expires_at")
  // pending | paid | failed | closed
  payStatus      String    @default("pending") @map("pay_status")
  // idle=未开卡；issued=CRM 已确认开卡；unknown=钱已到但开卡结果未确认（后台按 issueNextAt 自动重试）
  issueStatus    String    @default("idle") @map("issue_status")
  // 开卡失败重试账目：已试次数决定退避间隔；issueNextAt 为空表示可以立刻重试。
  issueAttempts  Int       @default(0) @map("issue_attempts")
  issueNextAt    DateTime? @map("issue_next_at")
  payMethod      String    @default("wechat") @map("pay_method")
  providerRef    String?   @map("provider_ref")
  failReason     String?   @map("fail_reason")
  paidAt         DateTime? @map("paid_at")
  crmCardId      String?   @map("crm_card_id")
  cardState      String?   @map("card_state")
  cardValidFrom  DateTime? @map("card_valid_from")
  cardValidUntil DateTime? @map("card_valid_until")
  issueError     String?   @map("issue_error")
  // 未支付单复用：缓存最近一次预下单参数，重复点击不再新建订单或重复下单到渠道。
  prepayJson     String?   @map("prepay_json")
  prepayAt       DateTime? @map("prepay_at")
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([customerId, createdAt])
  @@index([payStatus])
  @@index([issueStatus, issueNextAt])
  @@map("brand_card_orders")
}

// ========== 在店时段（灵活用工口径：只记录服务时段，不承载考勤/工资语义） ==========

/// 在店时段：一次「到店确认 → 离店确认」。
///
/// 设计要点：
/// - businessDate 按【到店时刻】的上海日期归属，跨零点不切分；结算按它分组；
/// - openKey 在段处于 open 时写入 userId、闭合即释放：唯一索引保证「一人同时只有一段」，
///   并发双击由数据库兜底，不依赖应用层的先查后写；
/// - pending_close = 员工已申报离店时间、等待总部审批，期间一律不计入工时；
/// - lapsed = 超过 16 小时未闭合，同样不计入，等待补签或作废；
/// - 只有 closed 参与时长汇总，这个口径是「宁可少算、不可虚增」的唯一实现点。
model WorkSession {
  id           String    @id
  storeId      String    @map("store_id")
  userId       String    @map("user_id")
  businessDate String    @map("business_date")
  clockInAt    DateTime  @map("clock_in_at")
  clockOutAt   DateTime? @map("clock_out_at")

  inLat        Float  @map("in_lat")
  inLng        Float  @map("in_lng")
  inAccuracyM  Int?   @map("in_accuracy_m")
  inDistanceM  Int?   @map("in_distance_m")
  outLat       Float? @map("out_lat")
  outLng       Float? @map("out_lng")
  outAccuracyM Int?   @map("out_accuracy_m")
  outDistanceM Int?   @map("out_distance_m")

  // open | pending_close | closed | lapsed | voided
  status String @default("open")

  /// 进行中的占用键：open 时 = userId，其它状态 = null（SQLite 唯一索引允许多个 NULL）
  openKey String? @unique @map("open_key")

  pendingApprovalId String?   @unique @map("pending_approval_id")
  note              String    @default("")
  adjustedBy        String?   @map("adjusted_by")
  adjustedAt        DateTime? @map("adjusted_at")
  adjustReason      String    @default("") @map("adjust_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([storeId, businessDate])
  @@index([userId, businessDate])
  @@index([status, clockInAt])
  @@map("work_sessions")
}

/// 计划班次：一人一店一日一条，startMin/endMin 为相对当日 00:00 的分钟数。
/// 只用于「计划 vs 实际」的对照提示，不阻断打卡、不产生金额差异。
model PlannedShift {
  id           String   @id
  storeId      String   @map("store_id")
  userId       String   @map("user_id")
  businessDate String   @map("business_date")
  startMin     Int      @map("start_min")
  endMin       Int      @map("end_min")
  note         String   @default("")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([storeId, userId, businessDate])
  @@index([storeId, businessDate])
  @@map("planned_shifts")
}

/// 劳务结算单：金额的唯一事实源，Expense 只是它的投影。
///
/// - draft 可反复重算；确认（posted）时冻结 linesJson 并同事务写入人力费用；
/// - 改错只能作废（void）+ 重出，绝不 update 已入账的 Expense；
/// - postedExpenseId 唯一，配合 Expense.sourceKey 兜住重复入账。
model WorkSettlement {
  id              String @id
  storeId         String @map("store_id")
  userId          String @map("user_id")
  periodStart     String @map("period_start")
  periodEnd       String @map("period_end")
  minutes         Int
  ratePerMinCents Int    @map("rate_per_min_cents")
  /// 出单时按门店单价算出的基础工资快照（分）
  baseAmountCents Int    @default(0) @map("base_amount_cents")
  /// 人工调整（可为负）；amountCents = baseAmountCents + adjustmentCents
  adjustmentCents Int    @default(0) @map("adjustment_cents")
  /// 调整备注（金额≠0 时必填）
  adjustmentNote  String @default("") @map("adjustment_note")
  amountCents     Int    @map("amount_cents")
  // draft | posted | voided
  status String @default("draft")

  linesJson String @default("[]") @map("lines_json")
  /// 出单时仍处于 pending_close / lapsed 的段数：> 0 时禁止确认入账（月结硬阻断）
  unclosedCount    Int @default(0) @map("unclosed_count")
  pendingApprovals Int @default(0) @map("pending_approvals")

  postedExpenseId String?   @unique @map("posted_expense_id")
  confirmedBy     String?   @map("confirmed_by")
  confirmedAt     DateTime? @map("confirmed_at")
  confirmedNote   String    @default("") @map("confirmed_note")
  voidedAt        DateTime? @map("voided_at")
  voidedBy        String?   @map("voided_by")
  voidReason      String    @default("") @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, userId, periodStart, periodEnd])
  @@index([storeId, periodStart])
  @@map("work_settlements")
}
