# 数据库（开发用 SQLite；上线切换 MySQL 见 prisma/schema.prisma 注释）
DATABASE_URL="file:./dev.db"
# JWT 密钥（上线必须替换为强随机值）
JWT_SECRET="teahour-dev-secret-change-me"
# 初始账号密码（种子写入，首次登录后请在后台修改）
SEED_PASSWORD="teahour2026"
# 端口
PORT=8787
# 开账交易与运营费用（0=只种子门店/商品/账号，不写入任何交易）
SEED_TRANSACTIONS=1

# ===== 对外接口（支付 / 打印 / 泡茶机 / 外卖平台 / 会员 / 微信 / 头像存储 / 资料同步）=====
# mock：内置模拟实现，不产生真实扣款与设备动作（本地开发默认）
# live：必须先在 packages/integrations/src/providers/live/index.ts 注册全部真实实现，缺一项启动即报错
INTEGRATIONS_MODE=mock
# 环境标识，仅用于状态展示（如 staging / prod-sh）
INTEGRATIONS_ENV=local
# 微信小程序与微信支付（live 模式必填）
WECHAT_APPID="wxd9e4e4568d1bc8bb"
WECHAT_APPSECRET=""
WECHAT_MCHID=""

# 飞鹅云标签机：杯贴右侧打印杯号二维码（打印时机以 INTEGRATIONS_PRINTER_MODE=live 为准）
# FEIE_USER / FEIE_UKEY 在飞鹅开发者后台获取；UKEY 不是打印机机身标签上的 KEY
FEIE_USER=""
FEIE_UKEY=""
# 默认打印机 SN（机身标签），以及门店 ID → SN 映射；门店未配置时用 FEIE_SN
FEIE_SN=""
FEIE_STORE_SN='{"sh":"SN-SH","bj":"SN-BJ"}'
# 标签纸尺寸与间距（mm）；40×30 不干胶常见间距 2mm，按实际纸卷调整
FEIE_LABEL_WIDTH_MM=40
FEIE_LABEL_HEIGHT_MM=30
FEIE_LABEL_GAP="2,0"
# 接口地址与超时
FEIE_API_BASE="https://api.de.feieyun.com"
FEIE_TIMEOUT_MS=10000
# 只切打印渠道：INTEGRATIONS_PRINTER_MODE=live
