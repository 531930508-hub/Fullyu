# Full愈 后端环境变量模板
# 复制为 apps/server/.env.local 并填入真实值（.env.local 已被 .gitignore/.dockerignore 排除）。
# @nestjs/config 加载顺序：.env.local > .env

# ===== 运行时 =====
NODE_ENV=production
PORT=3000
# 允许跨域来源（逗号分隔）：Admin 后台域名等。生产收敛到正式域名。
CORS_ORIGINS=https://admin.yourdomain.com

# ===== 数据库（阿里云 RDS MySQL）=====
# 本地/预发（docker compose --profile local）可用：
#   mysql://fullyu:fullyu@mysql:3306/fullyu
# 注意：MySQL 连接串不需要 ?schema= 参数；密码含特殊字符时按需 URL 编码。
DATABASE_URL=mysql://<username>:<password>@rm-bp127cdsipvc7dtseno.mysql.rds.aliyuncs.com:3306/fullyu

# ===== 缓存/锁（阿里云 Redis/Tair）=====
# 本地/预发（profile=local）：REDIS_HOST=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT =====
# C 端用户 JWT
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=7d
# 后台管理员 JWT（独立密钥）
ADMIN_JWT_SECRET=please-change-me-too
ADMIN_JWT_EXPIRES_IN=24h

# ===== 微信小程序 =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 支付下单环境：formal（正式）/ trial / develop
WECHAT_MP_STATE=formal

# ===== 汇付斗拱（BsPay 聚合支付）=====
# 系统号（渠道商/商户 huifu_id）与产品号，由汇付分配
HUIFU_SYS_ID=
HUIFU_PRODUCT_ID=
# 商户号；不填时默认取 HUIFU_SYS_ID
HUIFU_HUIFU_ID=
# 商户 RSA 私钥（加签）与汇付 RSA 公钥（验签）；支持裸 base64 或 PEM（换行用 \n）
HUIFU_RSA_PRIVATE_KEY=
HUIFU_RSA_PUBLIC_KEY=
# 支付结果回调地址（需已备案 HTTPS 域名；退款回调自动替换为 /payment/refund-notify）
HUIFU_NOTIFY_URL=https://api.yourdomain.com/api/v1/payment/notify
# 网关地址：生产 https://api.huifu.com，联调 https://spin-test.cloudpnr.com
HUIFU_API_BASE=https://api.huifu.com

# ===== 阿里云 OSS =====
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：CDN 加速域名（配置后返回该域名的 URL）
OSS_CDN_HOST=

# ===== 阿里云短信（可选）=====
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=

# ===== 小程序订阅消息模板 ID =====
WECHAT_TMPL_COURSE_REMINDER=
WECHAT_TMPL_WAITLIST_PROMOTED=
WECHAT_TMPL_PAYMENT_SUCCESS=
WECHAT_TMPL_REFUND_SUCCESS=

# ===== 密码安全策略 =====
# 总开关。false = 测试阶段：不限制强度、也不强制首次登录改密（仍然不允许空密码）
PASSWORD_POLICY_ENABLED=true
# 下面四项仅在总开关为 true 时生效
PASSWORD_MIN_LENGTH=6
PASSWORD_REQUIRE_LETTER=false
PASSWORD_REQUIRE_NUMBER=false
PASSWORD_REQUIRE_SYMBOL=false
# 新建账号首次登录、以及管理员代改密码后，是否强制本人修改密码
PASSWORD_FORCE_CHANGE_ON_FIRST_LOGIN=true

# ===== Seed 初始化 =====
# 测试阶段所有账号统一初始密码 123456；上线前改成强密码并打开 PASSWORD_POLICY_ENABLED
SEED_ADMIN_PASSWORD=123456
SEED_DEMO_PASSWORD=123456

# ===== 会员中心（CRM）=====
# CRM 是会员身份与积分的唯一账本。未接入时留空：登录/积分沿用本地库。
# 接入后：登录会解析 CRM 身份，/user/points 读 CRM 余额；CRM 不可用时明确返回 503，不回退本地积分。
# 留空=未开启（填了 CRM_BASE_URL 也会自动视为开启）；填 1 明确开启；填 0 强制关闭
CRM_ENABLED=
# CRM 服务地址（不要带 /api 后缀）；签名按 /api/external/... 完整路径计算
CRM_BASE_URL=
# 外部接口密钥 ID 与密钥（≥16 位随机串，由 CRM 运维下发；不得写入源码或提交到仓库）
CRM_KEY_ID=
CRM_SECRET=
# 调用超时（毫秒，默认 3000，自动收敛到 300–15000）
CRM_TIMEOUT_MS=3000

# ===== 品牌会员（Full愈 CRM，X-Fy 签名）=====
# 两项后台同步默认关闭；开启前需确认 CRM 已部署对应接口并获上线授权。
# 畅练卡有效期内附赠同期品牌会员（会员价/优先排位/邀请名额随品牌会员生效）
BRAND_PASS_BUNDLE_ENABLED=
# 已付款订单实付与累计退款上报（每满 ¥300 得一次游戏机会、会员节省金额）
BRAND_ORDER_REPORT_ENABLED=
