# Full愈 后端环境变量模板
# 复制为 apps/server/.env.local 并填入真实值（.env.local 已被 .gitignore/.dockerignore 排除）。
# @nestjs/config 加载顺序：.env.local > .env

# ===== 运行时 =====
NODE_ENV=production
PORT=3000
# 允许跨域来源（逗号分隔）：Admin 后台域名等。生产收敛到正式域名。
CORS_ORIGINS=https://admin.yourdomain.com

# ===== 数据库（阿里云 RDS PostgreSQL）=====
# 本地/预发（docker compose --profile local）可用：
#   postgresql://fullyu:fullyu@postgres:5432/fullyu?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fullyu?schema=public

# ===== 缓存/锁（阿里云 Redis/Tair）=====
# 本地/预发（profile=local）：REDIS_HOST=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT =====
# C 端用户 JWT
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=7d
# 后台管理员 JWT（独立密钥）
ADMIN_JWT_SECRET=please-change-me-too
ADMIN_JWT_EXPIRES_IN=24h

# ===== 微信小程序 =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 支付下单环境：formal（正式）/ trial / develop
WECHAT_MP_STATE=formal

# ===== 微信支付（APIv3）=====
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
# 商户 API 私钥（PEM），换行统一用字面量 \n
WECHAT_PAY_PRIVATE_KEY=
# APIv3 密钥（32 位，用于回调解密）
WECHAT_PAY_API_V3_KEY=
# 支付结果回调地址（需已备案 HTTPS 域名）
WECHAT_PAY_NOTIFY_URL=https://api.yourdomain.com/api/v1/payment/notify

# ===== 阿里云 OSS =====
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：CDN 加速域名（配置后返回该域名的 URL）
OSS_CDN_HOST=

# ===== 阿里云短信（可选）=====
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=

# ===== 小程序订阅消息模板 ID =====
WECHAT_TMPL_COURSE_REMINDER=
WECHAT_TMPL_WAITLIST_PROMOTED=
WECHAT_TMPL_PAYMENT_SUCCESS=
WECHAT_TMPL_REFUND_SUCCESS=

# ===== Seed 初始化 =====
# 超管初始密码（prisma db seed 使用，首次登录后请立即修改）
SEED_ADMIN_PASSWORD=Admin@123456
