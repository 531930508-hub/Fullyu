# 数据库（开发用 SQLite；上线切换 MySQL 见 prisma/schema.prisma 注释）
DATABASE_URL="file:./dev.db"
# JWT 密钥（上线必须替换为强随机值）
JWT_SECRET="teahour-dev-secret-change-me"
# 初始账号密码（种子写入，首次登录后请在后台修改）
SEED_PASSWORD="teahour2026"
# 端口
PORT=8787
# 开账交易与运营费用（0=只种子门店/商品/账号，不写入任何交易）
SEED_TRANSACTIONS=1

# ===== 对外接口（支付 / 打印 / 泡茶机 / 外卖平台 / 会员 / 微信 / 头像存储 / 资料同步）=====
# mock：内置模拟实现，不产生真实扣款与设备动作（本地开发默认）
# live：必须先在 packages/integrations/src/providers/live/index.ts 注册全部真实实现，缺一项启动即报错
INTEGRATIONS_MODE=mock
# 环境标识，仅用于状态展示（如 staging / prod-sh）
INTEGRATIONS_ENV=local

# ===== 会员中心（CRM）=====
# CRM 是会员身份与积分的唯一账本。未接入时保持 0/留空，顾客流程沿用本地 customers.points 只读展示。
# 接入后：登录/查询会员会调用 CRM；CRM 不可用时明确返回 503，绝不静默回退本地积分。
# 留空=未开启（填了 CRM_BASE_URL 也会自动视为开启）；填 1 明确开启；填 0 强制关闭
CRM_ENABLED=
# CRM 服务地址（不要带 /api 后缀）；签名按 /api/external/... 完整路径计算，反向代理不要改写该前缀
CRM_BASE_URL=""
# 外部接口密钥 ID 与密钥（≥16 位随机串，由 CRM 运维下发；不得写入源码或提交到仓库）
CRM_KEY_ID=""
CRM_SECRET=""
# 调用超时（毫秒，默认 3000，自动收敛到 300–15000）
CRM_TIMEOUT_MS=3000
# 微信小程序与微信支付（live 模式必填）
WECHAT_APPID="wxd9e4e4568d1bc8bb"
WECHAT_APPSECRET=""
WECHAT_MCHID=""

# 杯贴打印机：xpyun=芯烨条码云（XP-420B 联网，云端直推，默认）
# agent=芯烨 XP-420B 这类 USB 桌面机（门店打印代理领取）
# 当前门店实际是 XP-420B（203dpi / TSPL / USB）；接条码云后用 xpyun，门店就不用常开电脑。
PRINTER_DRIVER="xpyun"

# 门店打印代理令牌：{"门店ID":"16 位以上随机串"}；留空则 /api/print-agent/* 一律 401
# 生成：openssl rand -hex 24
PRINT_AGENT_TOKENS='{"sh":"replace-with-48-hex"}'

# TSPL 杯贴（40×60mm 不干胶，203dpi = 320×480 dots）
TSPL_LABEL_WIDTH_MM=40
TSPL_LABEL_HEIGHT_MM=60
TSPL_LABEL_GAP_MM=2
# 简体中文点阵字体；真机若出方块，换成机身支持的 TSS24.BF2 / TST24.BF2 并在自检标签上确认
TSPL_FONT_CN="TSS24.BF2"
# 浓度 0–15，热敏纸偏冷调到 9–10；速度 1–6（inch/s）
TSPL_DENSITY=8
TSPL_SPEED=4
# 杯贴时间按门店时区出
LABEL_TIME_ZONE="Asia/Shanghai"
# 杯贴底部的求助电话；留空则不印，不拿占位号码凑
TEAHOUR_SERVICE_PHONE=""

# 芯烨条码云（XP-420B 联网直推，PRINTER_DRIVER=xpyun 时生效）
# XPYUN_USER / XPYUN_UKEY 在 platform-barcode.xpyun.net 获取；UKEY 不是打印机机身标签上的 KEY
XPYUN_USER=""
XPYUN_UKEY=""
# 打印机 SN（机身顶部标签），以及门店 ID → SN 映射；门店未配置时用 XPYUN_SN
XPYUN_SN=""
XPYUN_STORE_SN='{"sh":"SN-SH"}'
XPYUN_LABEL_WIDTH_MM=40
XPYUN_LABEL_HEIGHT_MM=60
# 标签间隙（mm），40×60 铜版纸常见 2mm
XPYUN_LABEL_GAP_MM=2
XPYUN_API_BASE="https://open-barcode.xpyun.net/api/openapi"
XPYUN_TIMEOUT_MS=10000

# 自动发券全局紧急停止：不配置=按每条规则的「自动执行」开关运行；设 0/false/off 则全部停止自动执行（手动执行不受影响）
# 本地开发保持 0，避免本地库定时发券
COUPON_RULES_ENABLED=0
# 扫描整点（北京时间），默认 10 点；进程错过整点会顺延到下一轮 10 分钟内
COUPON_RULE_HOUR=10

# 定时任务总闸（双机切换用，2026-11-17 起）：
#   不配置 = 五类定时任务按各自开关运行（默认）
#   TASKS_ENABLED=false（0/off/no）= 全部不启动 —— 备机、切机演练
#   TASKS_ONLY=coupon,brand-order,card-sweep,attendance,daily-sweep = 只启动列出的
# 只影响定时器是否启动，接口里的「立即执行」等手工动作不受影响
#TASKS_ENABLED=false
#TASKS_ONLY=coupon,daily-sweep
