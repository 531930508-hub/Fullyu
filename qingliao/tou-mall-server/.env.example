# 轻疗商城后端（tou-mall-server）环境变量模板
# 复制为 .env.local 或写入服务器 /etc/fullyu/tou-mall-server.env 后注入，切勿提交真实值。
# Spring 通过 ${VAR:default} 读取；未提供的敏感项会为空导致对应能力不可用（支付/短信/OSS/微信登录）。

# ===== 数据库（阿里云 RDS MySQL）=====
# 用户名默认 fully，密码必须显式注入
DB_USERNAME=fully
DB_PASSWORD=<db-password>

# ===== RabbitMQ =====
RABBITMQ_PASSWORD=<rabbitmq-password>

# ===== MinIO（本地对象存储，可选）=====
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>

# ===== JWT（admin / portal 各自签发）=====
JWT_SECRET=<jwt-secret>

# ===== 阿里云 OSS（图片、语音文件）=====
ALIYUN_OSS_ACCESS_KEY_ID=<oss-access-key-id>
ALIYUN_OSS_ACCESS_KEY_SECRET=<oss-access-key-secret>

# ===== 阿里云短信 =====
ALIYUN_SMS_ACCESS_KEY_ID=<sms-access-key-id>
ALIYUN_SMS_ACCESS_KEY_SECRET=<sms-access-key-secret>

# ===== 微信 =====
WX_MINIAPP_SECRET=<miniapp-secret>
WX_MP_SECRET=<mp-secret>
WX_MP_TOKEN=<mp-token>
WX_MP_AES_KEY=<mp-aes-key>

# ===== 汇付天下（DouGong）支付 =====
# 商户号：总店 / 来福士 / 世纪汇
PAY_SYS_ID=<pay-sys-id>
PAY_SYS_ID_1=<pay-sys-id-1>
PAY_SYS_ID_2=<pay-sys-id-2>
PAY_SYS_ID_3=<pay-sys-id-3>
# 商户 RSA 私钥（Base64，无 PEM 头尾）
PAY_SECRET=<pay-secret>
PAY_SECRET_1=<pay-secret-1>
PAY_SECRET_2=<pay-secret-2>
PAY_SECRET_3=<pay-secret-3>
PAY_SIGN_SECRET=<pay-sign-secret>

# ===== 小票打印机（spyun）=====
PRINT_USER=<print-user>
PRINT_UKEY=<print-ukey>
PRINT_SN=<print-sn>
PRINT_APPID=<print-appid>
PRINT_APPSECRET=<print-appsecret>

# ===== 百度语音识别 / 合成 =====
BAIDU_VOICE_APP_ID=<baidu-app-id>
BAIDU_VOICE_API_KEY=<baidu-api-key>
BAIDU_VOICE_SECRET_KEY=<baidu-secret-key>

# ===== CRM 内部调用（可选，默认关闭）=====
CRM_INTERNAL_ENABLED=
CRM_INTERNAL_KEY_ID=
CRM_INTERNAL_SECRET=

# ===== 激励模块（可选，默认关闭）=====
INCENTIVE_TEAM_CERT_ENABLED=false