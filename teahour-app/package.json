{
  "name": "teahour-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full愈·时叙 tea retail operations system — production-oriented full stack implementation",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "start:env": "node --env-file=.env server/dist/index.js",
    "seed": "tsx server/src/seed-cli.ts",
    "test": "tsx --test --test-concurrency=1 server/test/*.test.ts",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@fastify/jwt": "^10.0.0",
    "@fastify/static": "^8.2.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.6.2",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
